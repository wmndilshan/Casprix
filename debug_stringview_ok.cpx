// Linear-view OK: parent `s` and view `v` die in the same scope, so the
// drop planner proves safety with no diagnostics.
class StringView {
    public let data: int;
    public let len: int;

    func StringView(src: string) -> void {
        this.data = 0;
        this.len = 0;
    }
}

func main() -> int {
    let s: string = "hello";
    let v: StringView = new StringView(s);
    return 0;
}

main();
