// Train Language Model on TinyStories
// Small transformer model training script (Modern Casprix Syntax)

// ==========================================
// External C Bindings (FFI)
// ==========================================

extern func nuwan_dataset_load(path: string) -> rawptr;
extern func nuwan_dataset_destroy(handle: rawptr) -> void;

extern func nuwan_transformer_create(vocab_size: i32, hidden_dim: i32, num_layers: i32, num_heads: i32, ffn_dim: i32, max_seq_len: i32) -> rawptr;
extern func nuwan_transformer_destroy(handle: rawptr) -> void;
extern func nuwan_transformer_get_num_params(handle: rawptr) -> i32;

extern func nuwan_adam_create(num_params: i32, lr: f32, beta1: f32, beta2: f32) -> rawptr;
extern func nuwan_adam_destroy(handle: rawptr) -> void;

// Simplified bindings - assume we pass raw pointers for arrays
extern func nuwan_train_step(model_handle: rawptr, opt_handle: rawptr, tokens: rawptr, targets: rawptr, batch: i32, seq_len: i32) -> f32;
extern func nuwan_eval_step(model_handle: rawptr, tokens: rawptr, targets: rawptr, batch: i32, seq_len: i32) -> f32;

extern func nuwan_dataloader_create(dataset: rawptr, batch_size: i32, shuffle: i32) -> rawptr;
extern func nuwan_dataloader_next_batch(handle: rawptr, batch_out: rawptr, targets_out: rawptr) -> i32;
extern func nuwan_dataloader_destroy(handle: rawptr) -> void;


// ==========================================
// Wrapper Classes
// ==========================================

class Dataset {
    public let handle: rawptr;

    public func new(path: string) -> void {
        this.handle = nuwan_dataset_load(path);
    }

    public func destroy() -> void {
        nuwan_dataset_destroy(this.handle);
    }
}

class DataLoader {
    public let handle: rawptr;

    public func new(dataset: Dataset, batch_size: i32, shuffle: bool) -> void {
        let shuff_val: i32 = 0;
        if (shuffle) { shuff_val = 1; }
        this.handle = nuwan_dataloader_create(dataset.handle, batch_size, shuff_val);
    }

    public func destroy() -> void {
        nuwan_dataloader_destroy(this.handle);
    }
}

class TransformerModel {
    public let handle: rawptr;

    public func new(vocab_size: i32, hidden_dim: i32, num_layers: i32, num_heads: i32, ffn_dim: i32, max_seq_len: i32) -> void {
        this.handle = nuwan_transformer_create(vocab_size, hidden_dim, num_layers, num_heads, ffn_dim, max_seq_len);
    }

    public func get_num_params() -> i32 {
        return nuwan_transformer_get_num_params(this.handle);
    }

    public func destroy() -> void {
        nuwan_transformer_destroy(this.handle);
    }
}

class AdamOptimizer {
    public let handle: rawptr;

    public func new(num_params: i32, lr: f32) -> void {
        // Defaults: beta1=0.9, beta2=0.999
        this.handle = nuwan_adam_create(num_params, lr, 0.9, 0.999);
    }

    public func destroy() -> void {
        nuwan_adam_destroy(this.handle);
    }
}


// ==========================================
// Configuration
// ==========================================

class ModelConfig {
    public mut vocab_size: i32;
    public mut hidden_dim: i32;
    public mut num_layers: i32;
    public mut num_heads: i32;
    public mut ffn_dim: i32;
    public mut max_seq_len: i32;

    public func new() -> void {
        this.vocab_size = 8192;
        this.hidden_dim = 256;
        this.num_layers = 6;
        this.num_heads = 8;
        this.ffn_dim = 1024;  // 4x hidden_dim
        this.max_seq_len = 256;
    }
}

class TrainingConfig {
    public mut learning_rate: f32;
    public mut batch_size: i32;
    public mut num_steps: i32;
    public mut log_interval: i32;
    public mut val_interval: i32;
    public mut save_interval: i32;

    public func new() -> void {
        this.learning_rate = 0.0003;
        this.batch_size = 32;
        // LOWERED for testing purposes: 10 steps instead of 100000
        this.num_steps = 10;
        this.log_interval = 1;
        this.val_interval = 5;
        this.save_interval = 10;
    }
}

class Trainer {
    public let model_config: ModelConfig;
    public let train_config: TrainingConfig;

    public func new() -> void {
        this.model_config = new ModelConfig();
        this.train_config = new TrainingConfig();
    }

    public func train() -> void {
        print("=== TinyStories Language Model Training (Modern Syntax) ===");

        // Note: dataset loading may fail if the dataset doesn't exist
        print("Loading datasets (skipping for dummy test)...");
        // let train_data: Dataset = new Dataset("data/tinystories_train.bin");
        
        print("Initializing model...");
        let model: TransformerModel = new TransformerModel(
            this.model_config.vocab_size,
            this.model_config.hidden_dim,
            this.model_config.num_layers,
            this.model_config.num_heads,
            this.model_config.ffn_dim,
            this.model_config.max_seq_len
        );

        let params: i32 = model.get_num_params();
        print("Model initialized with parameters:");
        print(params);

        print("Initializing optimizer...");
        let opt: AdamOptimizer = new AdamOptimizer(params, this.train_config.learning_rate);

        print("Starting training loop...");
        for (let step: i32 = 0; step < this.train_config.num_steps; step += 1) {
            
            // Dummy data pointers (rawptr of 0) since we don't have actual data loaded
            // In a real run, this would be retrieved from nuwan_dataloader_next_batch
            let dummy_tokens: rawptr = 0;
            let dummy_targets: rawptr = 0;
            
            // let loss: f32 = nuwan_train_step(model.handle, opt.handle, dummy_tokens, dummy_targets, this.train_config.batch_size, this.model_config.max_seq_len);
            let loss: f32 = 2.5; // Dummy loss

            if (step % this.train_config.log_interval == 0) {
                print("Step logged.");
            }
        }

        print("Training Complete!");

        model.destroy();
        opt.destroy();
    }

    public static func main() -> void {
        let trainer: Trainer = new Trainer();
        trainer.train();
    }
}

Trainer.main();
