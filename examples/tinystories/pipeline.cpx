// TinyStories Training Pipeline - Complete Workflow
// Run all steps from download to training

class TinyStoriesPipeline {
    static func main() -> void {
        print("===================================")
        print("  TinyStories Training Pipeline")
        print("===================================")
        print("")

        print("This pipeline will:")
        print("1. Download TinyStories dataset")
        print("2. Train BPE tokenizer (vocab_size=8192)")
        print("3. Tokenize and preprocess data")
        print("4. Split into train/val/test (90/5/5)")
        print("5. Train transformer model (15M params)")
        print("")

        // Step 1: Download dataset
        print("[1/5] Downloading dataset...")
        // Note: In practice, run download_dataset.cpx separately
        print("  → Run: casprix examples/tinystories/download_dataset.cpx")
        print("")

        // Step 2: Train tokenizer
        print("[2/5] Training tokenizer...")
        print("  → Run: casprix examples/tinystories/train_tokenizer.cpx")
        print("")

        // Step 3: Preprocess data
        print("[3/5] Preprocessing data...")
        print("  → Run: casprix examples/tinystories/preprocess_data.cpx")
        print("")

        // Step 4: Train model
        print("[4/5] Training model...")
        print("  → Run: casprix examples/tinystories/train_model.cpx")
        print("")

        // Step 5: Generate text
        print("[5/5] Generating stories...")
        print("  → Run: casprix examples/tinystories/generate_text.cpx")
        print("")

        print("===================================")
        print("Dataset Structure:")
        print("===================================")
        print("data/")
        print("├── tinystories_raw.txt       # Downloaded dataset")
        print("├── tokenizer.bin             # Trained tokenizer")
        print("├── tinystories_train.bin     # Training data")
        print("├── tinystories_val.bin       # Validation data")
        print("└── tinystories_test.bin      # Test data")
        print("")
        print("checkpoints/")
        print("└── step_*.ckpt               # Model checkpoints")
        print("")

        print("===================================")
        print("Model Specifications:")
        print("===================================")
        print("Architecture: Transformer Decoder")
        print("Parameters:   ~15M")
        print("Vocab size:   8,192")
        print("Hidden dim:   256")
        print("Layers:       6")
        print("Heads:        8")
        print("FFN dim:      1,024")
        print("Seq length:   256")
        print("")

        print("===================================")
        print("Training Configuration:")
        print("===================================")
        print("Optimizer:    Adam (lr=3e-4)")
        print("Batch size:   32")
        print("Steps:        100,000")
        print("Hardware:     CPU (AVX2+FMA)")
        print("Expected:     ~20 hours")
        print("")

        print("Ready to start training!")
        print("Run each script in order, or automate with a shell script.")
    }
}

TinyStoriesPipeline.main()
