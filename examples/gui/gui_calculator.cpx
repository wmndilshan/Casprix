// Casprix GUI Example
// Simple Calculator Application

import "GUI.cpx";

class Calculator {
    window: Window;
    display: TextBox;
    currentValue: int;
    operation: int;  // 0=none, 1=add, 2=sub, 3=mul, 4=div

    func new() -> Calculator {
        this.currentValue = 0;
        this.operation = 0;

        // Create main window
        this.window = new Window("Casprix Calculator", 300, 400);

        // Create display textbox
        this.display = new TextBox(10, 10, 280, 40, false);
        this.display.setReadOnly(true);
        this.display.setText("0");

        // In full implementation, would create number buttons 0-9
        // and operation buttons (+, -, *, /, =, C)

        return this;
    }

    func run() -> void {
        this.window.show();
        GUIRun();
    }

    func onNumberClick(digit: int) -> void {
        // Update display with new digit
        // this.currentValue = this.currentValue * 10 + digit;
        // this.updateDisplay();
    }

    func onOperationClick(op: int) -> void {
        // Store operation and current value
        this.operation = op;
    }

    func onEqualsClick() -> void {
        // Perform calculation based on operation
        // result: int = this.calculate();
        // this.display.setText(intToString(result));
    }

    func onClearClick() -> void {
        this.currentValue = 0;
        this.operation = 0;
        this.display.setText("0");
    }

    func updateDisplay() -> void {
        // Update the display textbox
        // this.display.setText(intToString(this.currentValue));
    }
}

// Main
GUIInit();
print(1);  // Calculator placeholder
calc: Calculator = new Calculator();
calc.run();
GUICleanup();
