// Simplified GUI Demo - Message Boxes Only
// Demonstrates GUI without custom window class registration

import "stdlib/GUI.cpx";

func main() -> void {
    // Show welcome message
    ShowInfo("Casprix GUI Demo", "Welcome to the Casprix GUI Library!");
    
    // Show features
    ShowInfo("Features Demonstrated", "This demo shows:\n- Message boxes\n- Information dialogs\n- Question dialogs\n- Modern Casprix syntax");
    
    // Ask a question
    result: int = AskYesNo("Question", "Do you like the Casprix programming language?");
    
    if result == 6 {  // IDYES = 6
        ShowInfo("Thank You!", "We're glad you like Casprix!\n\nThis GUI was built using:\n- Win32 C bindings\n- Modern object-oriented syntax\n- External function declarations");
    } else {
        ShowInfo("Feedback", "Thank you for trying Casprix!\n\nWe'll keep improving the language and tools.");
    }
    
    // Show success
    ShowInfo("Demo Complete", "The Casprix GUI library successfully:\n- Compiled to assembly\n- Assembled with NASM\n- Linked with GCC\n- Executed on Windows!");
    
    // Final message
    choice: int = AskYesNo("Continue?", "Would you like to see a warning example?");
    
    if choice == 6 {
        ShowWarning("Warning Example", "This is a warning message box.");
        ShowError("Error Example", "This is an error message box (for demonstration only).");
    }
    
    ShowMessage("Goodbye", "Thank you for using the Casprix GUI Demo!");
}
