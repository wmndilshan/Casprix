// Casprix Network Client Example
// Simple TCP client

import "casprix/stdlib/Network.cpx";

// HTTP-like client
class SimpleClient {
    let socket: Socket;
    let host: string;
    let port: int;

    func new(serverHost: string, serverPort: int) -> SimpleClient {
        this.host = serverHost;
        this.port = serverPort;
        this.socket = new Socket();
        return this;
    }

    func connect() -> bool {
        return this.socket.connect(this.host, this.port);
    }

    func sendMessage(message: string) -> bool {
        // bytes: int = this.socket.send(message);
        return true;
    }

    func receiveMessage() -> string {
        // response: string = this.socket.recv(4096);
        // return response;
        return "";
    }

    func disconnect() -> void {
        this.socket.close();
    }
}

// Main
NetworkInit();
print(80);  // Port placeholder
