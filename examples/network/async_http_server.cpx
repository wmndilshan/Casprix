// Casperix Example: High-Performance Async HTTP Server
// Planned surface demo; async/await/spawn are not accepted by the current parser yet.

import "std/net/tcp"
import "std/async"

async func handleClient(conn: owned TcpStream) -> void {
    // Read HTTP request
    let request = await conn.readUntil("\r\n\r\n")
    
    // Simple routing
    let response: String
    if request.contains("GET /") {
        response = "HTTP/1.1 200 OK\r\n" +
                  "Content-Type: text/plain\r\n" +
                  "Content-Length: 13\r\n" +
                  "\r\n" +
                  "Hello, World!"
    } else {
        response = "HTTP/1.1 404 Not Found\r\n" +
                  "Content-Length: 9\r\n" +
                  "\r\n" +
                  "Not Found"
    }
    
    // Send response
    await conn.writeAll(response)
}

async func main() -> int {
    // Initialize runtime
    print("Starting Casperix HTTP Server on port 8080...")
    
    let listener = TcpListener.bind("0.0.0.0:8080")
    
    // Accept connections in async loop
    while true {
        let client = await listener.accept()
        
        // Spawn task for each client (ownership transferred)
        spawn {
            await handleClient(move client)
        }
    }
    
    return 0
}
