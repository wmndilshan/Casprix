// hello_android.cpx — Minimal Android app in the ND/Casprix language
// 
// Shows the absolute minimum needed to create a working Android app:
//   - AndroidApp (window + event loop)
//   - Screen (AppBar + scrollable content)
//   - MaterialCard + MaterialButton
// 
// Run on desktop:
//   casprix examples/android/hello_android.cpx
// 
// Build Android APK:
//   apk-builder --input examples/android/hello_android.cpx \
//               --package com.casprix.hello \
//               --name "Hello Android" \
//               --output hello.apk

import "lib/android/android"

// Create the application (400×720 = phone portrait size)
let app   = new AndroidApp("Hello Android", 400, 720)
let NAV   = app.navigator()
let font  = app.get_font()
let bold  = app.get_font_bold()
let title = app.get_font_title()

// Build the screen
let scaffold = new Scaffold("Hello Android", 0, app.nav(), title, font)

// A card in the center
let card   = new MaterialCard()
let col    = new Column(16.0)

let greet  = new Text("👋 Hello from Casprix!", title, MD_ON_SURFACE)
let sub    = new Text("Running on the Android framework\nbuilt with Skia + ND language.",
                      font, MD_ON_SURFACE_MED)

let btn    = new MaterialButton()
btn.filled("Tap Me!", bold)

col.add(greet.handle)
col.add(sub.handle)
col.add(btn.handle)
card.add(col.handle)
scaffold.add(card.handle)

// Info chips
let chips_row = new Row(8.0)
let c1 = new Chip("Skia", font)
let c2 = new Chip("Native", font)
let c3 = new Chip("ARM64", font)
c1.select(1)
c2.select(1)
c3.select(1)
chips_row.add(c1.handle)
chips_row.add(c2.handle)
chips_row.add(c3.handle)
scaffold.add(chips_row.handle)

// Launch
let screen = scaffold.as_screen()
app.set_main_screen("MainActivity", screen)
app.run()
