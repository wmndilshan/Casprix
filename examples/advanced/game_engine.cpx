// Game Engine - Advanced OOP Test
// Tests: Complex class hierarchies, Composition, Encapsulation, static factories

import "Collections";

// ============================================================================
// 1. CORE MATH UTILITIES (static utility class)
// ============================================================================

class MathUtils {
    static PI: int = 314;  // PI * 100 for integer math

    static func abs(value: int) -> int {
        if (value < 0) {
            return 0 - value;
        }
        return value;
    }

    static func max(a: int, b: int) -> int {
        if (a > b) {
            return a;
        }
        return b;
    }

    static func min(a: int, b: int) -> int {
        if (a < b) {
            return a;
        }
        return b;
    }

    static func clamp(value: int, minVal: int, maxVal: int) -> int {
        if (value < minVal) {
            return minVal;
        }
        if (value > maxVal) {
            return maxVal;
        }
        return value;
    }
}

// ============================================================================
// 2. VECTOR2D (Position/Velocity representation)
// ============================================================================

class Vector2D {
    public x: int;
    public y: int;

    func new(xVal: int, yVal: int) -> Vector2D {
        this.x = xVal;
        this.y = yVal;
        return this;
    }

    public func add(other: Vector2D) -> Vector2D {
        result: Vector2D = new Vector2D(this.x + other.x, this.y + other.y);
        return result;
    }

    public func multiply(scalar: int) -> Vector2D {
        result: Vector2D = new Vector2D(this.x * scalar, this.y * scalar);
        return result;
    }

    public func magnitude() -> int {
        // Approximate magnitude (x + y) for simplicity
        return MathUtils.abs(this.x) + MathUtils.abs(this.y);
    }

    public func set(xVal: int, yVal: int) -> void {
        this.x = xVal;
        this.y = yVal;
    }

    static func zero() -> Vector2D {
        return new Vector2D(0, 0);
    }

    static func up() -> Vector2D {
        return new Vector2D(0, 1);
    }

    static func right() -> Vector2D {
        return new Vector2D(1, 0);
    }
}

// ============================================================================
// 3. GAME OBJECT BASE class
// ============================================================================

class GameObject {
    protected id: int;
    protected name: string;
    protected position: Vector2D;
    protected isActive: int;
    static nextId: int = 1;

    func new(objectName: string, x: int, y: int) -> GameObject {
        this.id = GameObject.nextId;
        GameObject.nextId = GameObject.nextId + 1;
        this.name = objectName;
        this.position = new Vector2D(x, y);
        this.isActive = 1;
        return this;
    }

    public func getId() -> int {
        return this.id;
    }

    public func getName() -> string {
        return this.name;
    }

    public func getPosition() -> Vector2D {
        return this.position;
    }

    public func setPosition(x: int, y: int) -> void {
        this.position.set(x, y);
    }

    public func move(dx: int, dy: int) -> void {
        this.position.x = this.position.x + dx;
        this.position.y = this.position.y + dy;
    }

    public func activate() -> void {
        this.isActive = 1;
    }

    public func deactivate() -> void {
        this.isActive = 0;
    }

    public func isActiveObject() -> int {
        return this.isActive;
    }
}

// ============================================================================
// 4. PLAYER (Derived from GameObject)
// ============================================================================

class Player {
    protected id: int;
    protected name: string;
    protected position: Vector2D;
    protected isActive: int;
    private health: int;
    private maxHealth: int;
    private score: int;
    private lives: int;
    private inventory: List;

    func new(playerName: string, x: int, y: int) -> Player {
        this.id = 1;
        this.name = playerName;
        this.position = new Vector2D(x, y);
        this.isActive = 1;
        this.health = 100;
        this.maxHealth = 100;
        this.score = 0;
        this.lives = 3;
        this.inventory = new List();
        return this;
    }

    public func getId() -> int {
        return this.id;
    }

    public func getName() -> string {
        return this.name;
    }

    public func getPosition() -> Vector2D {
        return this.position;
    }

    public func move(dx: int, dy: int) -> void {
        this.position.x = this.position.x + dx;
        this.position.y = this.position.y + dy;
    }

    public func getHealth() -> int {
        return this.health;
    }

    public func getScore() -> int {
        return this.score;
    }

    public func getLives() -> int {
        return this.lives;
    }

    public func takeDamage(damage: int) -> void {
        this.health = this.health - damage;
        if (this.health <= 0) {
            this.health = 0;
            this.die();
        }
    }

    func die() -> void {
        this.lives = this.lives - 1;
        if (this.lives > 0) {
            this.respawn();
        }
        print("Player died!");
    }

    func respawn() -> void {
        this.health = this.maxHealth;
        this.position.set(0, 0);
        print("Player respawned");
    }

    public func heal(amount: int) -> void {
        this.health = this.health + amount;
        if (this.health > this.maxHealth) {
            this.health = this.maxHealth;
        }
    }

    public func addScore(points: int) -> void {
        this.score = this.score + points;
    }

    public func collectItem(itemId: int) -> void {
        this.inventory.add(itemId);
        print("Item collected");
    }

    public func getInventorySize() -> int {
        return this.inventory.getSize();
    }
}

// ============================================================================
// 5. ENEMY (Derived from GameObject)
// ============================================================================

class Enemy {
    protected id: int;
    protected name: string;
    protected position: Vector2D;
    protected isActive: int;
    private health: int;
    private damage: int;
    private enemyType: int;  // 0=normal, 1=fast, 2=strong
    static enemiesDefeated: int = 0;

    func new(enemyName: string, x: int, y: int, type: int) -> Enemy {
        this.id = 2;
        this.name = enemyName;
        this.position = new Vector2D(x, y);
        this.isActive = 1;
        this.enemyType = type;

        // Set stats based on type
        if (type == 0) {
            this.health = 50;
            this.damage = 10;
        }
        if (type == 1) {
            this.health = 30;
            this.damage = 15;
        }
        if (type == 2) {
            this.health = 100;
            this.damage = 25;
        }

        return this;
    }

    public func getId() -> int {
        return this.id;
    }

    public func getName() -> string {
        return this.name;
    }

    public func getPosition() -> Vector2D {
        return this.position;
    }

    public func move(dx: int, dy: int) -> void {
        this.position.x = this.position.x + dx;
        this.position.y = this.position.y + dy;
    }

    public func getHealth() -> int {
        return this.health;
    }

    public func getDamage() -> int {
        return this.damage;
    }

    public func takeDamage(damage: int) -> void {
        this.health = this.health - damage;
        if (this.health <= 0) {
            this.health = 0;
            this.defeat();
        }
    }

    func defeat() -> void {
        this.isActive = 0;
        Enemy.enemiesDefeated = Enemy.enemiesDefeated + 1;
        print("Enemy defeated!");
    }

    public func attack(target: Player) -> void {
        if (this.isActive == 1) {
            target.takeDamage(this.damage);
            print("Enemy attacks!");
        }
    }

    public func moveToward(targetX: int, targetY: int) -> void {
        if (this.position.x < targetX) {
            this.position.x = this.position.x + 1;
        }
        if (this.position.x > targetX) {
            this.position.x = this.position.x - 1;
        }
        if (this.position.y < targetY) {
            this.position.y = this.position.y + 1;
        }
        if (this.position.y > targetY) {
            this.position.y = this.position.y - 1;
        }
    }

    static func getEnemiesDefeated() -> int {
        return Enemy.enemiesDefeated;
    }
}

// ============================================================================
// 6. POWERUP (Collectible items)
// ============================================================================

class PowerUp {
    protected id: int;
    protected name: string;
    protected position: Vector2D;
    protected isActive: int;
    private powerUpType: int;  // 0=health, 1=score, 2=weapon
    private value: int;

    func new(x: int, y: int, type: int, powerValue: int) -> PowerUp {
        this.id = 3;
        this.name = "PowerUp";
        this.position = new Vector2D(x, y);
        this.isActive = 1;
        this.powerUpType = type;
        this.value = powerValue;
        return this;
    }

    public func getId() -> int {
        return this.id;
    }

    public func getPosition() -> Vector2D {
        return this.position;
    }

    public func collect(player: Player) -> void {
        if (this.isActive == 1) {
            if (this.powerUpType == 0) {
                player.heal(this.value);
                print("Health powerup collected");
            }
            if (this.powerUpType == 1) {
                player.addScore(this.value);
                print("Score powerup collected");
            }
            this.isActive = 0;
        }
    }

    public func isActiveObject() -> int {
        return this.isActive;
    }
}

// ============================================================================
// 7. GAME WORLD (Manages all game objects)
// ============================================================================

class GameWorld {
    private worldName: string;
    private player: Player;
    private enemies: List;
    private powerUps: List;
    private width: int;
    private height: int;
    static currentLevel: int = 1;

    func new(name: string, w: int, h: int) -> GameWorld {
        this.worldName = name;
        this.enemies = new List();
        this.powerUps = new List();
        this.width = w;
        this.height = h;
        return this;
    }

    public func setPlayer(p: Player) -> void {
        this.player = p;
    }

    public func spawnEnemy(enemy: Enemy) -> void {
        this.enemies.add(enemy.getId());
        print("Enemy spawned");
    }

    public func spawnPowerUp(powerup: PowerUp) -> void {
        this.powerUps.add(powerup.getId());
        print("PowerUp spawned");
    }

    public func getEnemyCount() -> int {
        return this.enemies.getSize();
    }

    public func getPowerUpCount() -> int {
        return this.powerUps.getSize();
    }

    public func update() -> void {
        // Game loop update
        print("World updated");
    }

    static func getCurrentLevel() -> int {
        return GameWorld.currentLevel;
    }

    static func nextLevel() -> void {
        GameWorld.currentLevel = GameWorld.currentLevel + 1;
    }
}

// ============================================================================
// 8. GAME MANAGER (Controls game flow)
// ============================================================================

class GameManager {
    private world: GameWorld;
    private isRunning: int;
    private frameCount: int;
    static highScore: int = 0;

    func new() -> GameManager {
        this.isRunning = 0;
        this.frameCount = 0;
        return this;
    }

    public func createWorld(name: string) -> GameWorld {
        this.world = new GameWorld(name, 100, 100);
        print("Game world created");
        return this.world;
    }

    public func startGame() -> void {
        this.isRunning = 1;
        print("Game started!");
    }

    public func stopGame() -> void {
        this.isRunning = 0;
        print("Game stopped");
    }

    public func gameLoop() -> void {
        if (this.isRunning == 1) {
            this.frameCount = this.frameCount + 1;
            this.world.update();
        }
    }

    public func getFrameCount() -> int {
        return this.frameCount;
    }

    static func updateHighScore(score: int) -> void {
        if (score > GameManager.highScore) {
            GameManager.highScore = score;
        }
    }

    static func getHighScore() -> int {
        return GameManager.highScore;
    }
}

// ============================================================================
// 9. MAIN GAME DEMO
// ============================================================================

print("========================================");
print("Advanced Game Engine Demo");
print("========================================");
print("");

// Initialize game
print("1. Initializing game...");
manager: GameManager = new GameManager();
world: GameWorld = manager.createWorld("Level 1");
print("");

// Create player
print("2. Creating player...");
hero: Player = new Player("Hero", 50, 50);
world.setPlayer(hero);
print("  Player: Hero");
print("  Position: (50, 50)");
print("  Health: ");
print(hero.getHealth());
print("  Lives: ");
print(hero.getLives());
print("");

// Spawn enemies
print("3. Spawning enemies...");
enemy1: Enemy = new Enemy("Goblin", 10, 10, 0);
enemy2: Enemy = new Enemy("Orc", 80, 80, 2);
enemy3: Enemy = new Enemy("Scout", 30, 70, 1);
world.spawnEnemy(enemy1);
world.spawnEnemy(enemy2);
world.spawnEnemy(enemy3);
print("  Enemies spawned: ");
print(world.getEnemyCount());
print("");

// Spawn powerups
print("4. Spawning power-ups...");
health1: PowerUp = new PowerUp(25, 25, 0, 30);
score1: PowerUp = new PowerUp(75, 75, 1, 100);
world.spawnPowerUp(health1);
world.spawnPowerUp(score1);
print("  PowerUps spawned: ");
print(world.getPowerUpCount());
print("");

// Player movement
print("5. Player moves...");
print("  Moving from (50,50) to (55,60)");
hero.move(5, 10);
pos: Vector2D = hero.getPosition();
print("  New position: ");
print(pos.x);
print(", ");
print(pos.y);
print("");

// Combat
print("6. Combat sequence...");
print("  Enemy attacks player...");
enemy1.attack(hero);
print("  Player health: ");
print(hero.getHealth());
print("");

print("  Player attacks enemy...");
enemy1.takeDamage(60);
print("  Enemy defeated: ");
print(Enemy.getEnemiesDefeated());
print("");

// Collect powerup
print("7. Collecting powerups...");
health1.collect(hero);
print("  Player health after powerup: ");
print(hero.getHealth());
score1.collect(hero);
print("  Player score: ");
print(hero.getScore());
print("");

// Use static utilities
print("8. Math utilities test...");
result1: int = MathUtils.max(10, 25);
result2: int = MathUtils.clamp(150, 0, 100);
print("  max(10, 25) = ");
print(result1);
print("  clamp(150, 0, 100) = ");
print(result2);
print("");

// Game statistics
print("9. Game Statistics:");
print("  Current Level: ");
print(GameWorld.getCurrentLevel());
print("  Enemies Defeated: ");
print(Enemy.getEnemiesDefeated());
print("  High Score: ");
GameManager.updateHighScore(hero.getScore());
print(GameManager.getHighScore());
print("");

// Start game loop
print("10. Starting game loop...");
manager.startGame();
manager.gameLoop();
manager.gameLoop();
manager.gameLoop();
print("  Frames processed: ");
print(manager.getFrameCount());
print("");

print("========================================");
print("Demo Complete!");
print("========================================");
