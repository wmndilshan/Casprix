// Advanced Banking System - Comprehensive OOP Test
// Tests: Inheritance, Polymorphism, Encapsulation, static members, Access modifiers

import "Collections";

// ============================================================================
// 1. ACCOUNT BASE class (abstract-like base class)
// ============================================================================

class Account {
    protected accountNumber: int;
    protected balance: int;
    protected accountHolderId: int;  // Holder ID instead of name
    protected isActive: int;  // Boolean: 1 = active, 0 = inactive
    private pin: int;
    static totalAccounts: int = 0;
    static totalTransactions: int = 0;

    func new(number: int, holderId: int, initialBalance: int, pinCode: int) -> Account {
        this.accountNumber = number;
        this.accountHolderId = holderId;
        this.balance = initialBalance;
        this.pin = pinCode;
        this.isActive = 1;
        Account.totalAccounts = Account.totalAccounts + 1;
        return this;
    }

    // public interface
    public func getBalance() -> int {
        return this.balance;
    }

    public func getAccountNumber() -> int {
        return this.accountNumber;
    }

    public func getHolderId() -> int {
        return this.accountHolderId;
    }

    // protected - accessible to derived classes
    protected func validatePin(inputPin: int) -> int {
        if (inputPin == this.pin) {
            return 1;  // true
        }
        return 0;  // false
    }

    protected func updateBalance(amount: int) -> void {
        this.balance = this.balance + amount;
        Account.totalTransactions = Account.totalTransactions + 1;
    }

    // private - internal use only
    private func logTransaction(typeCode: int, amount: int) -> void {
        // In real system, would log to file/database
        // typeCode: 1=deposit, 2=withdrawal
        print("Transaction logged");
    }

    // Virtual method - can be overridden
    public func deposit(amount: int) -> int {
        if (amount <= 0) {
            return 0;  // Failed
        }
        this.updateBalance(amount);
        this.logTransaction(1, amount);
        return 1;  // Success
    }

    public func withdraw(amount: int, inputPin: int) -> int {
        if (this.validatePin(inputPin) == 0) {
            print("Invalid PIN");
            return 0;
        }
        if (amount > this.balance) {
            print("Insufficient funds");
            return 0;
        }
        this.updateBalance(0 - amount);
        this.logTransaction(2, amount);
        return 1;
    }

    public func deactivate() -> void {
        this.isActive = 0;
        Account.totalAccounts = Account.totalAccounts - 1;
    }

    static func getTotalAccounts() -> int {
        return Account.totalAccounts;
    }

    static func getTotalTransactions() -> int {
        return Account.totalTransactions;
    }
}

// ============================================================================
// 2. SAVINGS ACCOUNT (Derived class with interest)
// ============================================================================

class SavingsAccount {
    protected accountNumber: int;
    protected balance: int;
    protected accountHolderId: int;
    protected isActive: int;
    private pin: int;
    private interestRate: int;  // Percentage * 100 (e.g., 350 = 3.5%)
    private minimumBalance: int;

    func new(number: int, holderId: int, initialBalance: int, pinCode: int, minBalance: int) -> SavingsAccount {
        this.accountNumber = number;
        this.accountHolderId = holderId;
        this.balance = initialBalance;
        this.pin = pinCode;
        this.isActive = 1;
        this.interestRate = 350;  // 3.5%
        this.minimumBalance = minBalance;
        return this;
    }

    public func getBalance() -> int {
        return this.balance;
    }

    public func getAccountNumber() -> int {
        return this.accountNumber;
    }

    public func getHolderId() -> int {
        return this.accountHolderId;
    }

    protected func validatePin(inputPin: int) -> int {
        if (inputPin == this.pin) {
            return 1;
        }
        return 0;
    }

    protected func updateBalance(amount: int) -> void {
        this.balance = this.balance + amount;
    }

    public func deposit(amount: int) -> int {
        if (amount <= 0) {
            return 0;
        }
        this.updateBalance(amount);
        print("Deposit successful");
        return 1;
    }

    public func withdraw(amount: int, inputPin: int) -> int {
        if (this.validatePin(inputPin) == 0) {
            print("Invalid PIN");
            return 0;
        }
        newBalance: int = this.balance - amount;
        if (newBalance < this.minimumBalance) {
            print("Cannot withdraw - minimum balance required");
            return 0;
        }
        this.updateBalance(0 - amount);
        return 1;
    }

    public func applyInterest() -> void {
        interest: int = (this.balance * this.interestRate) / 10000;
        this.updateBalance(interest);
        print("Interest applied");
    }

    public func getMinimumBalance() -> int {
        return this.minimumBalance;
    }
}

// ============================================================================
// 3. CHECKING ACCOUNT (Derived class with overdraft)
// ============================================================================

class CheckingAccount {
    protected accountNumber: int;
    protected balance: int;
    protected accountHolderId: int;
    protected isActive: int;
    private pin: int;
    private overdraftLimit: int;
    private checksIssued: int;

    func new(number: int, holderId: int, initialBalance: int, pinCode: int, overdraft: int) -> CheckingAccount {
        this.accountNumber = number;
        this.accountHolderId = holderId;
        this.balance = initialBalance;
        this.pin = pinCode;
        this.isActive = 1;
        this.overdraftLimit = overdraft;
        this.checksIssued = 0;
        return this;
    }

    public func getBalance() -> int {
        return this.balance;
    }

    public func getAccountNumber() -> int {
        return this.accountNumber;
    }

    public func getHolderId() -> int {
        return this.accountHolderId;
    }

    protected func validatePin(inputPin: int) -> int {
        if (inputPin == this.pin) {
            return 1;
        }
        return 0;
    }

    protected func updateBalance(amount: int) -> void {
        this.balance = this.balance + amount;
    }

    public func deposit(amount: int) -> int {
        if (amount <= 0) {
            return 0;
        }
        this.updateBalance(amount);
        return 1;
    }

    public func withdraw(amount: int, inputPin: int) -> int {
        if (this.validatePin(inputPin) == 0) {
            print("Invalid PIN");
            return 0;
        }
        maxWithdrawal: int = this.balance + this.overdraftLimit;
        if (amount > maxWithdrawal) {
            print("Exceeds overdraft limit");
            return 0;
        }
        this.updateBalance(0 - amount);
        return 1;
    }

    public func issueCheck(amount: int, inputPin: int) -> int {
        if (this.withdraw(amount, inputPin) == 1) {
            this.checksIssued = this.checksIssued + 1;
            print("Check issued");
            return 1;
        }
        return 0;
    }

    public func getChecksIssued() -> int {
        return this.checksIssued;
    }
}

// ============================================================================
// 4. BANK MANAGER (Manages multiple accounts)
// ============================================================================

class Bank {
    private bankId: int;
    private accountList: List;
    private savingsCount: int;
    private checkingCount: int;
    static nextAccountNumber: int = 10000;

    func new(id: int) -> Bank {
        this.bankId = id;
        this.accountList = new List();
        this.savingsCount = 0;
        this.checkingCount = 0;
        return this;
    }

    public func getBankId() -> int {
        return this.bankId;
    }

    public func createSavingsAccount(holderId: int, initialDeposit: int, pin: int) -> SavingsAccount {
        accountNum: int = Bank.nextAccountNumber;
        Bank.nextAccountNumber = Bank.nextAccountNumber + 1;

        account: SavingsAccount = new SavingsAccount(accountNum, holderId, initialDeposit, pin, 1000);
        this.accountList.add(accountNum);
        this.savingsCount = this.savingsCount + 1;

        print("Savings account created");
        return account;
    }

    public func createCheckingAccount(holderId: int, initialDeposit: int, pin: int) -> CheckingAccount {
        accountNum: int = Bank.nextAccountNumber;
        Bank.nextAccountNumber = Bank.nextAccountNumber + 1;

        account: CheckingAccount = new CheckingAccount(accountNum, holderId, initialDeposit, pin, 500);
        this.accountList.add(accountNum);
        this.checkingCount = this.checkingCount + 1;

        print("Checking account created");
        return account;
    }

    public func getTotalAccounts() -> int {
        return this.accountList.getSize();
    }

    public func getSavingsCount() -> int {
        return this.savingsCount;
    }

    public func getCheckingCount() -> int {
        return this.checkingCount;
    }

    public func printStatistics() -> void {
        print("Bank Statistics:");
        print("  Total Accounts: ");
        print(this.getTotalAccounts());
        print("  Savings Accounts: ");
        print(this.savingsCount);
        print("  Checking Accounts: ");
        print(this.checkingCount);
    }
}

// ============================================================================
// 5. TRANSACTION PROCESSOR
// ============================================================================

class TransactionProcessor {
    private transactionQueue: Queue;
    private processedCount: int;
    static dailyLimit: int = 50000;

    func new() -> TransactionProcessor {
        this.transactionQueue = new Queue();
        this.processedCount = 0;
        return this;
    }

    public func queueTransaction(accountNum: int, amount: int) -> void {
        this.transactionQueue.enqueue(accountNum);
        print("Transaction queued");
    }

    public func processNext() -> int {
        if (this.transactionQueue.isEmpty() == 1) {
            return 0;
        }
        this.transactionQueue.dequeue();
        this.processedCount = this.processedCount + 1;
        return 1;
    }

    public func getProcessedCount() -> int {
        return this.processedCount;
    }

    static func getDailyLimit() -> int {
        return TransactionProcessor.dailyLimit;
    }
}

// ============================================================================
// 6. MAIN DEMONSTRATION
// ============================================================================

print("========================================");
print("Advanced Banking System Demo");
print("========================================");
print("");

// Create bank
print("1. Creating First National Bank...");
bank: Bank = new Bank(1);
print("");

// Create accounts
print("2. Creating customer accounts...");
savings1: SavingsAccount = bank.createSavingsAccount(101, 5000, 1234);  // Customer ID 101
checking1: CheckingAccount = bank.createCheckingAccount(102, 3000, 5678);  // Customer ID 102
savings2: SavingsAccount = bank.createSavingsAccount(103, 10000, 9012);  // Customer ID 103
print("");

// Display account info
print("3. Account Information:");
print("  Savings Account #1:");
print("    Holder ID: ");
print(savings1.getHolderId());
print("    Balance: ");
print(savings1.getBalance());
print("  Checking Account #1:");
print("    Holder ID: ");
print(checking1.getHolderId());
print("    Balance: ");
print(checking1.getBalance());
print("");

// Perform transactions
print("4. Performing transactions...");
print("  Depositing $2000 to Alice's savings...");
savings1.deposit(2000);
print("  New balance: ");
print(savings1.getBalance());
print("");

print("  Withdrawing $500 from Bob's checking...");
checking1.withdraw(500, 5678);
print("  New balance: ");
print(checking1.getBalance());
print("");

// Apply interest to savings
print("5. Applying interest to savings accounts...");
savings1.applyInterest();
print("  Alice's new balance: ");
print(savings1.getBalance());
print("");

// Issue check
print("6. Bob issues a check for $1000...");
checking1.issueCheck(1000, 5678);
print("  New balance: ");
print(checking1.getBalance());
print("  Total checks issued: ");
print(checking1.getChecksIssued());
print("");

// Test overdraft protection
print("7. Testing overdraft protection...");
print("  Attempting to withdraw $3000 (should fail)...");
result: int = checking1.withdraw(3000, 5678);
if (result == 0) {
    print("  Withdrawal blocked (as expected)");
}
print("");

// Transaction processing
print("8. Processing transactions...");
processor: TransactionProcessor = new TransactionProcessor();
processor.queueTransaction(10000, 1000);
processor.queueTransaction(10001, 2000);
processor.processNext();
print("  Processed transactions: ");
print(processor.getProcessedCount());
print("");

// Bank statistics
print("9. Bank Statistics:");
bank.printStatistics();
print("");

// static member access
print("10. System-wide Statistics:");
print("  Daily transaction limit: ");
print(TransactionProcessor.getDailyLimit());
print("  Next account number: ");
print(Bank.nextAccountNumber);
print("");

print("========================================");
print("Demo Complete!");
print("========================================");
