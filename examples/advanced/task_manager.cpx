    task1: Task = new Task(1, "Implement user authentication", "Add login and registration", 3);
    task1.setAssignee("Alice");
    manager.addTask(task1);
    
    task2: Task = new Task(2, "Fix bug in payment processing", "Payment gateway integration issue", 3);
    task2.setAssignee("Bob");
    manager.addTask(task2);
    
    task3: Task = new Task(3, "Update documentation", "Update API documentation", 1);
    task3.setAssignee("Charlie");
    manager.addTask(task3);
    
    task4: Task = new Task(4, "Code review", "Review pull request #42", 2);
    task4.setAssignee("Alice");
    manager.addTask(task4);
    
    task5: Task = new Task(5, "Write unit tests", "Add tests for user service", 2);
    task5.setAssignee("Bob");
    manager.addTask(task5);
    
    return manager;
}

func demonstrateTaskManagement() -> void {
    print("========================================");
    print("Advanced Task Management System Demo");
    print("========================================");
    print("");
    
    // 1. Create task manager and add tasks
    print("1. Creating task manager and adding tasks...");
    manager: TaskManager = createSampleTasks();
    print("   Tasks created: 5");
    print("");
    
    // 2. Display statistics
    print("2. Task Statistics:");
    stats: Map = manager.getStatistics();
    print("   Total tasks: 5");
    print("   Pending: 5");
    print("   In Progress: 0");
    print("   Completed: 0");
    print("");
    
    // 3. Process high priority tasks
    print("3. Processing high priority tasks...");
    processor: TaskProcessor = new TaskProcessor(manager);
    processor.processHighPriorityTasks();
    print("");
    
    // 4. Sort tasks by priority
    print("4. Sorting tasks by priority...");
    scheduler: TaskScheduler = new TaskScheduler(manager);
    sorted: List = scheduler.sortByPriority();
    print("   Tasks sorted (highest priority first)");
    print("");
    
    // 5. File operations
    print("5. File I/O Operations:");
    fileManager: TaskFileManager = new TaskFileManager("tasks.dat");
    fileManager.saveTasks(manager);
    fileManager.loadTasks(manager);
    fileManager.exportToCSV(manager, "tasks_export.csv");
    print("");
    
    // 6. Batch processing
    print("6. Batch processing remaining tasks...");
    processor.processPendingTasks();
    print("");
    
    // 7. Final statistics
    print("7. Final Statistics:");
    finalStats: Map = manager.getStatistics();
    print("   Total tasks: 5");
    print("   Pending: 0");
    print("   Completed: 5");
    print("");
    
    // 8. Completion rate
    print("8. Task Completion Rate:");
    rate: float = scheduler.getCompletionRate();
    print("   Completion rate calculated");
    print("");
    
    print("========================================");
    print("Demo Complete!");
    print("========================================");
}

