// ==========================================
// 3. THREADING & ASYNC OPERATIONS
// ==========================================

class TaskProcessor {
    manager: TaskManager;
    isRunning: bool;
    processedCount: int;

    func new(manager: TaskManager) -> TaskProcessor {
        this.manager = manager;
        this.isRunning = false;
        this.processedCount = 0;
        return this;
    }

    func processTask(taskId: int) -> void {
        task: Task = this.manager.getTask(taskId);
        if (task.id == 0) {
            return;
        }

        print("Processing task: ");
        print(taskId);
        print(" - ");
        print(task.title);

        task.start();
        
        // Simulate work
        ThreadSleep(100);  // Simulate processing time
        
        task.complete();
        this.processedCount = this.processedCount + 1;
        
        print("Task completed: ");
        print(taskId);
    }

    func processPendingTasks() -> void {
        print("Starting batch processing...");
        this.isRunning = true;
        
        pending: List = this.manager.getPendingTasks();
        i: int = 0;
        while (i < pending.getSize()) {
            taskId: int = pending.get(i);
            this.processTask(taskId);
            i = i + 1;
        }
        
        this.isRunning = false;
        print("Batch processing complete. Processed: ");
        print(this.processedCount);
    }

    func processHighPriorityTasks() -> void {
        print("Processing high priority tasks...");
        
        highPriority: List = this.manager.getTasksByPriority(3);  // Critical
        i: int = 0;
        while (i < highPriority.getSize()) {
            taskId: int = highPriority.get(i);
            this.processTask(taskId);
            i = i + 1;
        }
        
        print("High priority tasks processed");
    }
}

// ==========================================
// 4. COMPLEX ALGORITHMS
// ==========================================

class TaskScheduler {
    manager: TaskManager;

    func new(manager: TaskManager) -> TaskScheduler {
        this.manager = manager;
        return this;
    }

    // Sort tasks by priority (highest first)
    func sortByPriority() -> List {
        allTasks: List = new List();
        i: int = 0;
        while (i < this.manager.taskList.getSize()) {
            allTasks.add(this.manager.taskList.get(i));
            i = i + 1;
        }

        // Bubble sort by priority (simple algorithm)
        n: int = allTasks.getSize();
        i = 0;
        while (i < n - 1) {
            j: int = 0;
            while (j < n - i - 1) {
                taskId1: int = allTasks.get(j);
                taskId2: int = allTasks.get(j + 1);
                task1: Task = this.manager.getTask(taskId1);
                task2: Task = this.manager.getTask(taskId2);
                
                if (task1.priority < task2.priority) {
                    // Swap
                    allTasks.insert(j, taskId2);
                    allTasks.insert(j + 2, taskId1);
                }
                j = j + 1;
            }
            i = i + 1;
        }

        return allTasks;
    }

    // Find tasks matching search criteria
    func searchTasks(keyword: string) -> List {
        results: List = new List();
        i: int = 0;
        while (i < this.manager.taskList.getSize()) {
            taskId: int = this.manager.taskList.get(i);
            task: Task = this.manager.getTask(taskId);
            
            // Simple string matching (would use proper string comparison)
            // if (task.title contains keyword || task.description contains keyword) {
            //     results.add(taskId);
            // }
            
            i = i + 1;
        }
        return results;
    }

    // Calculate task completion rate
    func getCompletionRate() -> float {
        stats: Map = this.manager.getStatistics();
        total: int = 0;  // Would get from stats
        completed: int = 0;  // Would get from stats
        
        if (total == 0) {
            return 0.0;
        }
        
        rate: float = 0.0;  // Would calculate: (completed / total) * 100.0
        return rate;
    }
}

