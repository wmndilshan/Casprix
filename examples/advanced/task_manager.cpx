// Task Priority Enum (simulated with int)
// 0 = Low, 1 = Medium, 2 = High, 3 = Critical

// Task Status Enum (simulated with int)
// 0 = Pending, 1 = InProgress, 2 = Completed, 3 = Cancelled

// Task class with full OOP features
class Task {
    id: int;
    title: string;
    description: string;
    priority: int;      // 0-3
    status: int;        // 0-3
    created: int;        // Timestamp
    completed: int;     // Timestamp (0 if not completed)
    assignee: string;
    tags: List;         // List of string tags

    func new(id: int, title: string, description: string, priority: int) -> Task {
        this.id = id;
        this.title = title;
        this.description = description;
        this.priority = priority;
        this.status = 0;  // Pending
        this.created = 0;  // Would be current timestamp
        this.completed = 0;
        this.assignee = "";
        this.tags = new List();
        return this;
    }

    func setAssignee(name: string) -> void {
        this.assignee = name;
    }

    func addTag(tag: string) -> void {
        this.tags.add(0);  // Placeholder - would add tag string
    }

    func start() -> void {
        this.status = 1;  // InProgress
    }

    func complete() -> void {
        this.status = 2;  // Completed
        this.completed = 0;  // Would be current timestamp
    }

    func cancel() -> void {
        this.status = 3;  // Cancelled
    }

    func getPriorityName() -> string {
        if (this.priority == 0) {
            return "Low";
        } elif (this.priority == 1) {
            return "Medium";
        } elif (this.priority == 2) {
            return "High";
        } else {
            return "Critical";
        }
    }

    func getStatusName() -> string {
        if (this.status == 0) {
            return "Pending";
        } elif (this.status == 1) {
            return "InProgress";
        } elif (this.status == 2) {
            return "Completed";
        } else {
            return "Cancelled";
        }
    }

    func toString() -> string {
        // Would format: "Task #id: title [Priority] - Status"
        return this.title;
    }
}

// Task Manager with Collections
class TaskManager {
    tasks: Map;          // Map<int, Task> - id -> task
    taskList: List;     // List<Task> - ordered list
    priorityQueue: PriorityQueue;  // for priority-based processing
    completedTasks: List;  // List of completed task IDs

    func new() -> TaskManager {
        this.tasks = new Map();
        this.taskList = new List();
        this.priorityQueue = new PriorityQueue();
        this.completedTasks = new List();
        return this;
    }

    func addTask(task: Task) -> void {
        this.tasks.put(task.id, 0);  // Placeholder - would store task
        this.taskList.add(task.id);
        this.priorityQueue.add(task.priority, task.id);
    }

    func getTask(id: int) -> Task {
        // Would retrieve from map
        // return dummy task for now
        dummyTask: Task = new Task(id, "Dummy", "Placeholder task", 1);
        return dummyTask;
    }

    func getTasksByPriority(priority: int) -> List {
        result: List = new List();
        i: int = 0;
        while (i < this.taskList.getSize()) {
            taskId: int = this.taskList.get(i);
            task: Task = this.getTask(taskId);
            if (task.priority == priority) {
                result.add(taskId);
            }
            i = i + 1;
        }
        return result;
    }

    func getPendingTasks() -> List {
        result: List = new List();
        i: int = 0;
        while (i < this.taskList.getSize()) {
            taskId: int = this.taskList.get(i);
            task: Task = this.getTask(taskId);
            if (task.status == 0) {
                result.add(taskId);
            }
            i = i + 1;
        }
        return result;
    }

    func completeTask(id: int) -> bool {
        task: Task = this.getTask(id);
        if (task.id == 0) {
            return false;
        }
        task.complete();
        this.completedTasks.add(id);
        return true;
    }

    func getStatistics() -> Map {
        stats: Map = new Map();
        
        total: int = this.taskList.getSize();
        pending: int = 0;
        inProgress: int = 0;
        completed: int = this.completedTasks.getSize();
        cancelled: int = 0;

        i: int = 0;
        while (i < this.taskList.getSize()) {
            taskId: int = this.taskList.get(i);
            task: Task = this.getTask(taskId);
            if (task.status == 0) {
                pending = pending + 1;
            } elif (task.status == 1) {
                inProgress = inProgress + 1;
            } elif (task.status == 3) {
                cancelled = cancelled + 1;
            }
            i = i + 1;
        }

        // Using hash codes as keys (0=total, 1=pending, 2=inProgress, 3=completed, 4=cancelled)
        stats.put(0, total);
        stats.put(1, pending);
        stats.put(2, inProgress);
        stats.put(3, completed);
        stats.put(4, cancelled);

        return stats;
    }
}

