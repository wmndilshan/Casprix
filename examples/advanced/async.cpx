// Casprix Language Examples - Async/Await
// Planned surface demo; async/await is not accepted by the current parser yet.

import Std.Net

print("=== Async/Await Example ===")

// Async function to fetch data
async func fetchUser(id: int) -> string {
    print("Fetching user " + id + "...")

    // Simulate network delay
    await Sleep(100)

    return "User{id=" + id + ", name='Alice'}"
}

// Async function to process data
async func processData(userId: int) -> int {
    print("Processing data for user " + userId)

    let user = await fetchUser(userId)
    print("Got user: " + user)

    // Simulate processing
    await Sleep(50)

    return userId * 2
}

// Main async function
async func main() {
    print("Starting async operations...")

    // Single await
    let result1 = await processData(1)
    print("Result 1: " + result1)

    // Multiple awaits
    let result2 = await processData(2)
    let result3 = await processData(3)

    print("Result 2: " + result2)
    print("Result 3: " + result3)

    // Parallel execution (conceptual)
    let future1 = fetchUser(10)
    let future2 = fetchUser(20)

    let user1 = await future1
    let user2 = await future2

    print("Users: " + user1 + ", " + user2)

    print("\n✓ Async operations completed!")
}

// Run main
await main()
