// University Management System - Comprehensive OOP Test
// Tests: Multiple inheritance simulation, Complex relationships, Encapsulation

import "Collections";

// ============================================================================
// 1. PERSON BASE class
// ============================================================================

class Person {
    protected mut id: int;
    protected mut firstName: string;
    protected mut lastName: string;
    protected mut age: int;
    protected mut email: string;
    static mut totalPeople: int = 0;

    func new(personId: int, first: string, last: string, personAge: int) -> Person {
        this.id = personId;
        this.firstName = first;
        this.lastName = last;
        this.age = personAge;
        this.email = "";
        Person.totalPeople = Person.totalPeople + 1;
        return this;
    }

    public func getId() -> int {
        return this.id;
    }

    public func getFirstName() -> string {
        return this.firstName;
    }

    public func getLastName() -> string {
        return this.lastName;
    }

    public func getAge() -> int {
        return this.age;
    }

    public func setEmail(newEmail: string) -> void {
        this.email = newEmail;
    }

    public func getEmail() -> string {
        return this.email;
    }

    public func getFullName() -> string {
        // Would concatenate in real implementation
        return this.firstName;
    }

    static func getTotalPeople() -> int {
        return Person.totalPeople;
    }
}

// ============================================================================
// 2. STUDENT class
// ============================================================================

class Student {
    protected mut id: int;
    protected mut firstName: string;
    protected mut lastName: string;
    protected mut age: int;
    protected mut email: string;
    private mut studentId: string;
    private mut enrolledCourses: List;
    private mut grades: Map;
    private mut gpa: int;  // GPA * 100 (e.g., 350 = 3.50)
    private mut credits: int;
    static mut totalStudents: int = 0;

    func new(personId: int, first: string, last: string, personAge: int, studId: string) -> Student {
        this.id = personId;
        this.firstName = first;
        this.lastName = last;
        this.age = personAge;
        this.email = "";
        this.studentId = studId;
        this.enrolledCourses = new List();
        this.grades = new Map();
        this.gpa = 0;
        this.credits = 0;
        Student.totalStudents = Student.totalStudents + 1;
        return this;
    }

    public func getId() -> int {
        return this.id;
    }

    public func getFirstName() -> string {
        return this.firstName;
    }

    public func getStudentId() -> string {
        return this.studentId;
    }

    public func enrollCourse(courseId: int) -> void {
        this.enrolledCourses.add(courseId);
        print("Student enrolled in course");
    }

    public func dropCourse(courseId: int) -> void {
        // Would remove course
        print("Student dropped course");
    }

    public func getEnrolledCount() -> int {
        return this.enrolledCourses.getSize();
    }

    public func setGrade(courseId: int, grade: int) -> void {
        this.grades.put(courseId, grade);
        this.calculateGPA();
    }

    private func calculateGPA() -> void {
        // Simplified GPA calculation
        courseCount: int = this.grades.getSize();
        if (courseCount > 0) {
            this.gpa = 350;  // Placeholder
        }
    }

    public func getGPA() -> int {
        return this.gpa;
    }

    public func addCredits(count: int) -> void {
        this.credits = this.credits + count;
    }

    public func getCredits() -> int {
        return this.credits;
    }

    static func getTotalStudents() -> int {
        return Student.totalStudents;
    }
}

// ============================================================================
// 3. PROFESSOR class
// ============================================================================

class Professor {
    protected mut id: int;
    protected mut firstName: string;
    protected mut lastName: string;
    protected mut age: int;
    protected mut email: string;
    private mut employeeId: string;
    private mut department: string;
    private mut taughtCourses: List;
    private mut salary: int;
    private mut yearsExperience: int;
    private mut publications: int;
    static mut totalProfessors: int = 0;

    func new(personId: int, first: string, last: string, personAge: int, empId: string, dept: string) -> Professor {
        this.id = personId;
        this.firstName = first;
        this.lastName = last;
        this.age = personAge;
        this.email = "";
        this.employeeId = empId;
        this.department = dept;
        this.taughtCourses = new List();
        this.salary = 60000;
        this.yearsExperience = 0;
        this.publications = 0;
        Professor.totalProfessors = Professor.totalProfessors + 1;
        return this;
    }

    public func getId() -> int {
        return this.id;
    }

    public func getFirstName() -> string {
        return this.firstName;
    }

    public func getEmployeeId() -> string {
        return this.employeeId;
    }

    public func getDepartment() -> string {
        return this.department;
    }

    public func assignCourse(courseId: int) -> void {
        this.taughtCourses.add(courseId);
        print("Professor assigned to course");
    }

    public func removeCourse(courseId: int) -> void {
        print("Professor removed from course");
    }

    public func getCourseCount() -> int {
        return this.taughtCourses.getSize();
    }

    public func setSalary(amount: int) -> void {
        this.salary = amount;
    }

    public func getSalary() -> int {
        return this.salary;
    }

    public func addPublication() -> void {
        this.publications = this.publications + 1;
    }

    public func getPublications() -> int {
        return this.publications;
    }

    public func promote() -> void {
        this.salary = this.salary + 10000;
        print("Professor promoted!");
    }

    static func getTotalProfessors() -> int {
        return Professor.totalProfessors;
    }
}

// ============================================================================
// 4. COURSE class
// ============================================================================

class Course {
    private mut courseId: int;
    private mut courseName: string;
    private mut courseCode: string;
    private mut credits: int;
    private mut capacity: int;
    private mut enrolledStudents: List;
    private mut professorId: int;
    private mut semester: string;
    static mut totalCourses: int = 0;
    static mut nextCourseId: int = 1000;

    func new(name: string, code: string, courseCredits: int, maxCapacity: int) -> Course {
        this.courseId = Course.nextCourseId;
        Course.nextCourseId = Course.nextCourseId + 1;
        this.courseName = name;
        this.courseCode = code;
        this.credits = courseCredits;
        this.capacity = maxCapacity;
        this.enrolledStudents = new List();
        this.professorId = 0;
        this.semester = "Fall 2025";
        Course.totalCourses = Course.totalCourses + 1;
        return this;
    }

    public func getCourseId() -> int {
        return this.courseId;
    }

    public func getCourseName() -> string {
        return this.courseName;
    }

    public func getCourseCode() -> string {
        return this.courseCode;
    }

    public func getCredits() -> int {
        return this.credits;
    }

    public func enrollStudent(studentId: int) -> int {
        currentSize: int = this.enrolledStudents.getSize();
        if (currentSize >= this.capacity) {
            print("Course is full");
            return 0;  // Failed
        }
        this.enrolledStudents.add(studentId);
        print("Student enrolled in course");
        return 1;  // Success
    }

    public func dropStudent(studentId: int) -> void {
        print("Student dropped from course");
    }

    public func getEnrollmentCount() -> int {
        return this.enrolledStudents.getSize();
    }

    public func assignProfessor(profId: int) -> void {
        this.professorId = profId;
        print("Professor assigned to course");
    }

    public func getProfessorId() -> int {
        return this.professorId;
    }

    public func isFull() -> int {
        if (this.enrolledStudents.getSize() >= this.capacity) {
            return 1;  // true
        }
        return 0;  // false
    }

    static func getTotalCourses() -> int {
        return Course.totalCourses;
    }
}

// ============================================================================
// 5. DEPARTMENT class
// ============================================================================

class Department {
    private mut departmentId: int;
    private mut name: string;
    private mut professors: List;
    private mut courses: List;
    private mut budget: int;
    private mut chairId: int;
    static mut departmentCount: int = 0;

    func new(deptId: int, deptName: string, deptBudget: int) -> Department {
        this.departmentId = deptId;
        this.name = deptName;
        this.professors = new List();
        this.courses = new List();
        this.budget = deptBudget;
        this.chairId = 0;
        Department.departmentCount = Department.departmentCount + 1;
        return this;
    }

    public func getDepartmentId() -> int {
        return this.departmentId;
    }

    public func getName() -> string {
        return this.name;
    }

    public func addProfessor(profId: int) -> void {
        this.professors.add(profId);
        print("Professor added to department");
    }

    public func addCourse(courseId: int) -> void {
        this.courses.add(courseId);
        print("Course added to department");
    }

    public func getProfessorCount() -> int {
        return this.professors.getSize();
    }

    public func getCourseCount() -> int {
        return this.courses.getSize();
    }

    public func setBudget(amount: int) -> void {
        this.budget = amount;
    }

    public func getBudget() -> int {
        return this.budget;
    }

    public func setChair(profId: int) -> void {
        this.chairId = profId;
        print("Department chair appointed");
    }

    static func getDepartmentCount() -> int {
        return Department.departmentCount;
    }
}

// ============================================================================
// 6. UNIVERSITY class
// ============================================================================

class University {
    private mut name: string;
    private mut students: List;
    private mut professors: List;
    private mut departments: List;
    private mut courses: List;
    private mut established: int;
    static mut ranking: int = 100;

    func new(univName: string, year: int) -> University {
        this.name = univName;
        this.students = new List();
        this.professors = new List();
        this.departments = new List();
        this.courses = new List();
        this.established = year;
        return this;
    }

    public func getName() -> string {
        return this.name;
    }

    public func registerStudent(student: Student) -> void {
        this.students.add(student.getId());
        print("Student registered at university");
    }

    public func hireProfessor(professor: Professor) -> void {
        this.professors.add(professor.getId());
        print("Professor hired");
    }

    public func addDepartment(dept: Department) -> void {
        this.departments.add(dept.getDepartmentId());
        print("Department added");
    }

    public func addCourse(course: Course) -> void {
        this.courses.add(course.getCourseId());
        print("Course added to catalog");
    }

    public func getStudentCount() -> int {
        return this.students.getSize();
    }

    public func getProfessorCount() -> int {
        return this.professors.getSize();
    }

    public func getDepartmentCount() -> int {
        return this.departments.getSize();
    }

    public func getCourseCount() -> int {
        return this.courses.getSize();
    }

    public func printStatistics() -> void {
        print("University Statistics:");
        print("  Total Students: ");
        print(this.getStudentCount());
        print("  Total Professors: ");
        print(this.getProfessorCount());
        print("  Total Departments: ");
        print(this.getDepartmentCount());
        print("  Total Courses: ");
        print(this.getCourseCount());
    }

    static func getRanking() -> int {
        return University.ranking;
    }

    static func improveRanking(positions: int) -> void {
        University.ranking = University.ranking - positions;
    }
}

// ============================================================================
// 7. MAIN DEMONSTRATION
// ============================================================================

print("========================================");
print("University Management System Demo");
print("========================================");
print("");

// Create university
print("1. Creating Tech University...");
university: University = new University("Tech University", 1950);
print("");

// Create departments
print("2. Creating departments...");
csDept: Department = new Department(1, "Computer Science", 500000);
mathDept: Department = new Department(2, "Mathematics", 300000);
university.addDepartment(csDept);
university.addDepartment(mathDept);
print("");

// Hire professors
print("3. Hiring professors...");
prof1: Professor = new Professor(101, "Dr. Smith", "Johnson", 45, "P001", "Computer Science");
prof2: Professor = new Professor(102, "Dr. Alice", "Brown", 38, "P002", "Mathematics");
prof3: Professor = new Professor(103, "Dr. Bob", "Wilson", 52, "P003", "Computer Science");
university.hireProfessor(prof1);
university.hireProfessor(prof2);
university.hireProfessor(prof3);
csDept.addProfessor(101);
mathDept.addProfessor(102);
csDept.addProfessor(103);
print("");

// Create courses
print("4. Creating courses...");
course1: Course = new Course("Data Structures", "CS201", 4, 30);
course2: Course = new Course("Algorithms", "CS301", 4, 25);
course3: Course = new Course("Calculus I", "MATH101", 3, 40);
university.addCourse(course1);
university.addCourse(course2);
university.addCourse(course3);
csDept.addCourse(course1.getCourseId());
csDept.addCourse(course2.getCourseId());
mathDept.addCourse(course3.getCourseId());
print("");

// Assign professors to courses
print("5. Assigning professors to courses...");
course1.assignProfessor(101);
course2.assignProfessor(103);
course3.assignProfessor(102);
prof1.assignCourse(course1.getCourseId());
prof2.assignCourse(course3.getCourseId());
prof3.assignCourse(course2.getCourseId());
print("");

// Register students
print("6. Registering students...");
student1: Student = new Student(1001, "John", "Doe", 20, "S001");
student2: Student = new Student(1002, "Jane", "Smith", 19, "S002");
student3: Student = new Student(1003, "Mike", "Johnson", 21, "S003");
university.registerStudent(student1);
university.registerStudent(student2);
university.registerStudent(student3);
print("");

// Enroll students in courses
print("7. Enrolling students in courses...");
student1.enrollCourse(course1.getCourseId());
student1.enrollCourse(course3.getCourseId());
course1.enrollStudent(1001);
course3.enrollStudent(1001);

student2.enrollCourse(course1.getCourseId());
student2.enrollCourse(course2.getCourseId());
course1.enrollStudent(1002);
course2.enrollStudent(1002);

print("  Course CS201 enrollment: ");
print(course1.getEnrollmentCount());
print("");

// Set grades
print("8. Recording grades...");
student1.setGrade(course1.getCourseId(), 85);
student1.addCredits(4);
print("  Student GPA: ");
print(student1.getGPA());
print("  Credits earned: ");
print(student1.getCredits());
print("");

// Professor activities
print("9. Professor activities...");
prof1.addPublication();
prof1.addPublication();
print("  Dr. Smith publications: ");
print(prof1.getPublications());
prof1.promote();
print("  New salary: ");
print(prof1.getSalary());
print("");

// Department management
print("10. Department management...");
csDept.setChair(103);
print("  CS Department professors: ");
print(csDept.getProfessorCount());
print("  CS Department courses: ");
print(csDept.getCourseCount());
print("  Department budget: ");
print(csDept.getBudget());
print("");

// University statistics
print("11. University Statistics:");
university.printStatistics();
print("");

// static counters
print("12. System-wide Statistics:");
print("  Total People: ");
print(Person.getTotalPeople());
print("  Total Students: ");
print(Student.getTotalStudents());
print("  Total Professors: ");
print(Professor.getTotalProfessors());
print("  Total Courses: ");
print(Course.getTotalCourses());
print("  University Ranking: ");
print(University.getRanking());
print("");

print("========================================");
print("Demo Complete!");
print("========================================");
