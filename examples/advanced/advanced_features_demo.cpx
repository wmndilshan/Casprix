// Casprix Advanced Features Demonstration
// Planned surface demo: exception handling, generics, traits, lambdas, and optimizations.
// This file intentionally uses syntax that is not fully accepted by the current parser yet.

import "casprix/stdlib/Exceptions.cpx";
import "casprix/stdlib/Generics.cpx";
import "casprix/stdlib/Interfaces.cpx";
import "casprix/stdlib/Lambdas.cpx";

print("=== Advanced Features Demo ===");
print("");

// ==========================================
// 1. EXCEPTION HANDLING
// ==========================================
print("1. Exception Handling:");
print("");

// Try-catch example
try {
    print("Attempting risky operation...");

    // Simulate error condition
    value: int = 0;  // -1;
    if (value < 0) {
        throw new IllegalArgumentException("Value cannot be negative");
    }

    print("Operation successful!");

} catch (ex: IllegalArgumentException) {
    print("Caught IllegalArgumentException: ");
    print(ex.getMessage());

} catch (ex: Exception) {
    print("Caught general exception: ");
    print(ex.getMessage());
}

print("");

// Try-catch-finally example
try {
    print("Opening resource...");
    // Simulate resource usage

} catch (ex: IOException) {
    print("IO Error: ");
    print(ex.getMessage());

} finally {
    print("Cleaning up resources (always executed)");
}

print("");

// ==========================================
// 2. GENERIC TYPES
// ==========================================
print("2. Generic Types:");
print("");

// Generic List with integers
intList: List<int> = new List<int>();
intList.add(10);
intList.add(20);
intList.add(30);
print("Integer list size: ");
print(intList.getSize());

first: int = intList.get(0);
print("First element: ");
print(first);

// Generic Map
map: Map<string, int> = new Map<string, int>();
map.put("Alice", 25);
map.put("Bob", 30);
map.put("Charlie", 35);

aliceAge: int = map.get("Alice");
print("Alice's age: ");
print(aliceAge);

hasKey: bool = map.containsKey("Bob");
if (hasKey) {
    print("Map contains key 'Bob'");
}

// Generic Pair
pair: Pair<string, int> = new Pair<string, int>("Score", 100);
key: string = pair.getFirst();
value: int = pair.getSecond();
print("Pair: ");
print(key);
print(" = ");
print(value);

// Generic Optional
opt: Optional<string> = Optional.of("Hello");
if (opt.isPresent()) {
    val: string = opt.get();
    print("Optional value: ");
    print(val);
}

print("");

// ==========================================
// 3. INTERFACES
// ==========================================
print("3. Interfaces:");
print("");

// Comparable interface
int1: Integer = new Integer(10);
int2: Integer = new Integer(20);
comparison: int = int1.compareTo(int2);

if (comparison < 0) {
    print("10 < 20");
}

// Multiple interfaces
doc: Document = new Document("Report", "Content here");
serialized: string = doc.serialize();
print("Serialized: ");
print(serialized);

clone: Cloneable = doc.clone();
print("Document cloned successfully");

// Interface inheritance
eagle: Bird = new Eagle("Golden Eagle");
sound: string = eagle.makeSound();
print("Eagle says: ");
print(sound);

eagle.fly();
eggs: int = eagle.layEggs();
print("Eagle laid eggs: ");
print(eggs);

print("");

// ==========================================
// 4. TRAITS
// ==========================================
print("4. Traits:");
print("");

// Trait with default implementations
circle: Circle = new Circle(100, 100, 50);
circle.show();   // Uses trait's default implementation
circle.draw();   // Uses class's implementation
circle.hide();   // Uses trait's default implementation

// Trait composition
user: User = new User("alice", "alice@example.com");
user.log("Creating user account");
isValid: bool = user.isValid();

if (isValid) {
    print("User is valid");
} else {
    user.logError("User validation failed");
}

print("");

// ==========================================
// 5. lambda FUNCTIONS
// ==========================================
print("5. Lambda Functions:");
print("");

// Simple lambdas
square: IntFunction = (x: int) => x * x;
result1: int = square(5);
print("Square of 5: ");
print(result1);

add: BinaryFunction = (a: int, b: int) => a + b;
result2: int = add(10, 20);
print("10 + 20 = ");
print(result2);

// Predicate
isPositive: Predicate = (x: int) => x > 0;
check: bool = isPositive(5);
if (check) {
    print("5 is positive");
}

// Higher-order functions
list: FunctionalList = new FunctionalList();
list.add(1);
list.add(2);
list.add(3);
list.add(4);
list.add(5);

// Map
doubled: FunctionalList = list.map((x: int) => x * 2);
print("Doubled list created");

// Filter
evens: FunctionalList = list.filter((x: int) => x % 2 == 0);
print("Filtered even numbers");

// Reduce
sum: int = list.reduce((acc: int, x: int) => acc + x, 0);
print("Sum of list: ");
print(sum);

// ForEach
print("List elements:");
list.forEach((x: int) => {
    print(x);
});

// Closures
counter: Counter = new Counter();
inc: Supplier = counter.makeIncrementer(10);
val1: int = inc();
val2: int = inc();
val3: int = inc();
print("Counter values: ");
print(val1);
print(val2);
print(val3);

// Currying
mathOps: MathOps = new MathOps();
add5: IntFunction = mathOps.adder(5);
result3: int = add5(10);
print("5 + 10 = ");
print(result3);

// Function composition
utils: FunctionUtils = new FunctionUtils();
addOne: IntFunction = (x: int) => x + 1;
timeTwo: IntFunction = (x: int) => x * 2;
combined: IntFunction = utils.compose(timeTwo, addOne);
result4: int = combined(5);
print("(5 + 1) * 2 = ");
print(result4);

print("");

// ==========================================
// 6. COMPILER OPTIMIZATIONS
// ==========================================
print("6. Compiler Optimizations:");
print("");

// Constant folding examples (optimized at compile time)
a: int = 10 + 20;           // Folded to 30
b: int = 5 * 6;             // Folded to 30
c: int = 100 / 2;           // Folded to 50
d: int = (3 + 4) * (5 - 2); // Folded to 21

print("Constant folding results:");
print(a);  // 30
print(b);  // 30
print(c);  // 50
print(d);  // 21

// Algebraic simplification examples
x: int = 42;
y: int = x + 0;    // Simplified to x
z: int = x * 1;    // Simplified to x
w: int = x - 0;    // Simplified to x

// Dead code elimination example
if (true) {
    print("This code runs");
} else {
    // This code is eliminated (unreachable)
    print("Never executed");
}

func testDeadCode() -> int {
    return 42;
    // Everything after return is eliminated
    // print("Unreachable");
    // return 0;
}

print("");

// ==========================================
// 7. COMBINING FEATURES
// ==========================================
print("7. Combining Advanced Features:");
print("");

// Generic collection with lambda operations
class SmartList<T> {
    data: List<T>;

    func new() -> SmartList<T> {
        this.data = new List<T>();
        return this;
    }

    // Use lambda for transformation
    func transform(mapper: Function<T, T>) -> SmartList<T> {
        result: SmartList<T> = new SmartList<T>();
        // Apply mapper to each element
        return result;
    }

    func add(item: T) -> void {
        try {
            this.data.add(item);
        } catch (ex: Exception) {
            print("Error adding item");
        }
    }

    // Implement interface methods
    func remove(item: T) -> bool { return false; }
    func contains(item: T) -> bool { return false; }
    func getSize() -> int { return this.data.getSize(); }
    func isEmpty() -> bool { return this.data.isEmpty(); }
    func clear() -> void { this.data.clear(); }
}

// Use the smart list
smartList: SmartList<int> = new SmartList<int>();
smartList.add(1);
smartList.add(2);
smartList.add(3);

// Transform with lambda
transformed: SmartList<int> = smartList.transform((x: int) => x * 10);

print("SmartList demonstration complete");

print("");
print("=== All Advanced Features Demonstrated ===");
