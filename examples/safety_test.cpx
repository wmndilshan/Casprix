class Data {
    let value: int;
}

func test_move_safety() -> void {
    let d1 = new Data();
    let d2 = move d1; // d1 is now moved
    
    // This should trigger an error: Use of moved value 'd1'
    print(d1.value);
}

struct Point {
    x: i32;
    y: i32;
}

func get_local_ref() -> ref<Point> {
    let p = new Point(); 
    p.x = 10;
    // This should trigger an error: Cannot return reference to local stack-allocated variable 'p'
    return p; 
}

func main() -> void {
    test_move_safety();
}
