// =============================================================================
// Casprix LLM Pre-Training — Main Entry Point
//
// This script orchestrates the full pre-training pipeline on TinyStories:
//
//   Phase 1: BPE Tokenizer Training
//     - Train a 32K vocabulary BPE tokenizer from raw TinyStories text
//     - Save vocab + merge rules to disk
//
//   Phase 2: Dataset Preparation
//     - Encode the TinyStories corpus with the trained tokenizer
//     - Save binary shards
//
//   Phase 3: Model Initialization
//     - Instantiate a small GPT-2 style transformer (Tiny model: ~15M params)
//     - Initialize AdamW optimizer with cosine learning rate schedule
//
//   Phase 4: Pre-Training Loop
//     - For each step: load batch -> forward pass -> backward pass -> optimizer step
//     - Log training loss, val loss, learning rate every N steps
//     - Save checkpoints periodically
//
// Usage (once compiler supports full pipeline):
//   cpx run examples/llm_training/train_llm.cpx
//
// Expected data layout:
//   data/tinystories_train.txt      - raw training text (download from HuggingFace)
//   data/tinystories_val.txt        - raw validation text
//   data/tok32k.bin                 - trained tokenizer (output of Phase 1)
//   data/train_shard_*.bin          - tokenized training shards (output of Phase 2)
//   data/val_shard_*.bin            - tokenized val shards
//   checkpoints/model_step_*.bin    - model checkpoints
//
// All syntax follows the CORRECT modern Casprix grammar:
//   let name: type = value        (immutable)
//   mut name: type = value        (mutable)
//   for (i: i32 = 0; i < n; i = i + 1)
//   class fields: public let / public mut
//   extern func name(p: type) -> type
// =============================================================================

import "examples/llm_training/tokenizer"
import "examples/llm_training/transformer"
import "examples/llm_training/dataloader"

// ---------------------------------------------------------------------------
// Additional FFI: timing, printing helpers
// ---------------------------------------------------------------------------

extern func get_time_ms() -> i32
extern func print_f32(val: f32) -> void
extern func print_loss_log(step: i32, loss: f32, lr: f32, dt_ms: i32) -> void
extern func encode_corpus_to_shards(
    tokenizer_path: string,
    input_txt: string,
    output_prefix: string,
    shard_size: i32
) -> i32



// ---------------------------------------------------------------------------
// TrainingConfig: all training hyperparameters
// ---------------------------------------------------------------------------

class TrainingConfig {
    // Data
    public mut train_data_prefix: string
    public mut val_data_prefix: string
    public mut raw_train_text: string
    public mut raw_val_text: string
    public mut tokenizer_path: string
    public mut checkpoint_dir: string

    // Tokenizer
    public mut base_vocab_size: i32
    public mut target_vocab_size: i32

    // Batching
    public mut batch_size: i32
    public mut seq_len: i32

    // Optimization
    public mut max_lr: f32
    public mut min_lr: f32
    public mut warmup_steps: i32
    public mut total_steps: i32
    public mut beta1: f32
    public mut beta2: f32
    public mut epsilon: f32
    public mut weight_decay: f32
    public mut grad_clip: f32

    // Logging / checkpointing
    public mut log_interval: i32
    public mut val_interval: i32
    public mut val_steps: i32
    public mut save_interval: i32

    public func new() -> void {
        // Data paths
        this.raw_train_text = "data/tinystories_train.txt"
        this.raw_val_text = "data/tinystories_val.txt"
        this.tokenizer_path = "data/tok32k.bin"
        this.train_data_prefix = "data/train_shard"
        this.val_data_prefix = "data/val_shard"
        this.checkpoint_dir = "checkpoints"

        // Tokenizer: 256 byte base + merges up to 32K
        this.base_vocab_size = 256
        this.target_vocab_size = 32000

        // Training batch: 64 sequences of 256 tokens each = 16K tokens/step
        this.batch_size = 64
        this.seq_len = 256

        // Learning rate: cosine decay from 3e-4 to 3e-5
        this.max_lr = 0.0003
        this.min_lr = 0.00003
        this.warmup_steps = 100
        this.total_steps = 1050      // A realistic epoch test scale

        // AdamW hyperparameters (GPT-2 defaults)
        this.beta1 = 0.9
        this.beta2 = 0.95
        this.epsilon = 0.00000001     // 1e-8
        this.weight_decay = 0.1
        this.grad_clip = 1.0

        // Logging and checkpointing
        this.log_interval = 50
        this.val_interval = 250
        this.val_steps = 20
        this.save_interval = 500
    }

    // Quick config for testing (10 steps only)
    public func make_tiny_run() -> void {
        this.total_steps = 10
        this.val_steps = 2
        this.log_interval = 1
        this.val_interval = 5
        this.save_interval = 10
        this.batch_size = 4
        this.seq_len = 64
        print("Using tiny test run config (10 steps).")
    }
}


// ---------------------------------------------------------------------------
// Phase 1: Train BPE Tokenizer
// ---------------------------------------------------------------------------

func train_tokenizer(cfg: TrainingConfig) -> void {
    print("")
    print("=== Phase 1: BPE Tokenizer Training ===")

    let tok: BpeTokenizer = new BpeTokenizer(cfg.base_vocab_size, cfg.target_vocab_size)
    tok.train(cfg.raw_train_text, cfg.target_vocab_size)
    tok.save(cfg.tokenizer_path)
    tok.destroy()

    print("Tokenizer training complete.")
}


// ---------------------------------------------------------------------------
// Phase 2: Tokenize and shard the corpus
// ---------------------------------------------------------------------------

func prepare_dataset(cfg: TrainingConfig) -> void {
    print("")
    print("=== Phase 2: Tokenizing TinyStories Corpus ===")

    let shard_size: i32 = 10000000   // 10M tokens per shard

    print("Encoding training set...")
    let train_shards: i32 = encode_corpus_to_shards(
        cfg.tokenizer_path,
        cfg.raw_train_text,
        cfg.train_data_prefix,
        shard_size
    )
    print("Training shards created:")
    print(train_shards)

    print("Encoding validation set...")
    let val_shards: i32 = encode_corpus_to_shards(
        cfg.tokenizer_path,
        cfg.raw_val_text,
        cfg.val_data_prefix,
        shard_size
    )
    print("Validation shards created:")
    print(val_shards)

    print("Dataset preparation complete.")
}


// ---------------------------------------------------------------------------
// Phase 3 + 4: Model Init + Pre-Training Loop
// ---------------------------------------------------------------------------

func pretrain(cfg: TrainingConfig) -> void {
    print("")
    print("=== Phase 3: Model Initialization ===")

    // Build model config (TinyStories-appropriate small model)
    let model_cfg: ModelConfig = new ModelConfig()
    model_cfg.tiny()
    model_cfg.vocab_size = cfg.target_vocab_size
    model_cfg.max_seq_len = cfg.seq_len
    model_cfg.print_info()

    // Create model
    let model: TransformerModel = new TransformerModel(model_cfg)
    let num_params: i32 = model.num_params()
    print("Model parameters:")
    print(num_params)

    // Create optimizer
    let opt: AdamWOptimizer = new AdamWOptimizer(
        num_params,
        cfg.max_lr,
        cfg.beta1,
        cfg.beta2,
        cfg.epsilon,
        cfg.weight_decay
    )

    // Create data loaders
    let train_loader: DataLoader = new DataLoader(
        cfg.train_data_prefix,
        cfg.batch_size,
        cfg.seq_len,
        0       // 0 = train split
    )
    let val_loader: DataLoader = new DataLoader(
        cfg.val_data_prefix,
        cfg.batch_size,
        cfg.seq_len,
        1       // 1 = val split
    )

    print("")
    print("=== Phase 4: Pre-Training Loop ===")
    print("Total steps:")
    print(cfg.total_steps)
    print("Batch size:")
    print(cfg.batch_size)
    print("Sequence length:")
    print(cfg.seq_len)
    print("")

    // Training loop
    for (step: i32 = 0; step < cfg.total_steps; step = step + 1) {

        // ── Validation loss (every val_interval steps) ──────────────────
        if step % cfg.val_interval == 0 {
            print("--- Validation ---")
            val_loader.reset()

            mut val_loss_sum: f32 = 0.0
            for (v: i32 = 0; v < cfg.val_steps; v = v + 1) {
                val_loader.next_batch()
                let loss: f32 = model.forward(
                    val_loader.tokens_buf,
                    val_loader.targets_buf,
                    cfg.batch_size,
                    cfg.seq_len
                )
                val_loss_sum = val_loss_sum + loss
            }
            // Average val loss
            let avg_val_loss: f32 = val_loss_sum / cfg.val_steps
            print("  Val loss:")
            print_f32(avg_val_loss)
        }

        // ── Checkpoint (every save_interval steps) ───────────────────────
        if step % cfg.save_interval == 0 && step > 0 {
            print("--- Saving checkpoint at step:")
            print(step)
            model.save("checkpoints/model_step.bin")
        }

        // ── Training step ────────────────────────────────────────────────
        let t0: i32 = get_time_ms()

        // Update learning rate (cosine schedule)
        let lr: f32 = compute_cosine_lr(
            step,
            cfg.warmup_steps,
            cfg.total_steps,
            cfg.max_lr,
            cfg.min_lr
        )
        opt.set_lr(lr)

        // Load next batch
        train_loader.next_batch()

        // Forward pass (compute loss)
        model.zero_grad()
        let loss: f32 = model.forward(
            train_loader.tokens_buf,
            train_loader.targets_buf,
            cfg.batch_size,
            cfg.seq_len
        )

        // Backward pass (compute gradients)
        model.backward()

        // Optimizer step (update weights)
        opt.step(model)

        let t1: i32 = get_time_ms()
        let dt: i32 = t1 - t0

        // ── Logging ──────────────────────────────────────────────────────
        if step % cfg.log_interval == 0 {
            print_loss_log(step, loss, lr, dt)
        }
    }

    print("")
    print("=== Training Complete ===")
    print("Saving final model...")
    model.save("checkpoints/model_final.bin")

    // Cleanup
    train_loader.destroy()
    val_loader.destroy()
    opt.destroy()
    model.destroy()
}


// ---------------------------------------------------------------------------
// Main Entry Point
// ---------------------------------------------------------------------------

func main() -> void {
    print("======================================================")
    print("  Casprix LLM Pre-Training on TinyStories")
    print("======================================================")

    let cfg: TrainingConfig = new TrainingConfig()

    // Uncomment for a quick 10-step smoke test:
    // cfg.make_tiny_run()

    // Phase 1: Train BPE tokenizer from raw text
    train_tokenizer(cfg)

    // Phase 2: Encode corpus into binary shards
    prepare_dataset(cfg)

    // Phase 3 + 4: Initialize model and run pre-training loop
    pretrain(cfg)

    print("")
    print("All phases complete.")
    print("Your model is saved in: checkpoints/model_final.bin")
    print("Your tokenizer is saved in: data/tok32k.bin")
}

// Top-level call: Casprix executes this directly
main()
