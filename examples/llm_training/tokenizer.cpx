// =============================================================================
// Casprix LLM Training - BPE Tokenizer
//
// Implements a Byte-Pair Encoding (BPE) tokenizer that:
//   1. Trains a vocabulary from raw text (merge rules)
//   2. Encodes raw text into token IDs
//   3. Decodes token IDs back to text
//
// This module communicates with C via the FFI (extern func) for
// performance-critical operations (hash maps, string manipulation).
//
// Syntax note: Uses correct modern Casprix syntax:
//   - let name: type = value     (immutable binding)
//   - mut name: type = value     (mutable binding)
//   - class fields: public let / public mut
//   - for loops: for (i: i32 = 0; i < n; i = i + 1)
//   - no ++ operator, use i = i + 1
// =============================================================================

// ---------------------------------------------------------------------------
// FFI: Low-level C functions for BPE tokenizer backend
// ---------------------------------------------------------------------------

// Allocate and manage a BPE vocab table in C (hash map: string -> i32)
extern func bpe_vocab_create() -> rawptr
extern func bpe_vocab_destroy(vocab: rawptr) -> void
extern func bpe_vocab_insert(vocab: rawptr, token: string, id: i32) -> void
extern func bpe_vocab_lookup(vocab: rawptr, token: string) -> i32
extern func bpe_vocab_size(vocab: rawptr) -> i32

// Merge-rules table: array of (pair_string -> merged_id)
extern func bpe_merges_create() -> rawptr
extern func bpe_merges_destroy(merges: rawptr) -> void
extern func bpe_merges_insert(merges: rawptr, left: i32, right: i32, merged: i32) -> void
extern func bpe_merges_lookup(merges: rawptr, left: i32, right: i32) -> i32

// Token sequence utilities
extern func bpe_tokens_create(capacity: i32) -> rawptr
extern func bpe_tokens_destroy(tokens: rawptr) -> void
extern func bpe_tokens_push(tokens: rawptr, id: i32) -> void
extern func bpe_tokens_get(tokens: rawptr, idx: i32) -> i32
extern func bpe_tokens_length(tokens: rawptr) -> i32
extern func bpe_tokens_replace_pair(tokens: rawptr, left: i32, right: i32, merged: i32) -> i32

// Corpus statistics (pair counting for BPE training)
extern func bpe_pair_stats_create() -> rawptr
extern func bpe_pair_stats_destroy(stats: rawptr) -> void
extern func bpe_pair_stats_count(stats: rawptr, tokens: rawptr) -> void
extern func bpe_pair_stats_best_pair(stats: rawptr, out_left: rawptr, out_right: rawptr) -> i32
extern func bpe_pair_stats_reset(stats: rawptr) -> void

// File I/O
extern func bpe_load_text_file(path: string, out_len: rawptr) -> rawptr
extern func bpe_save_vocab_file(vocab: rawptr, merges: rawptr, path: string) -> void
extern func bpe_load_vocab_file(path: string, vocab: rawptr, merges: rawptr) -> void
extern func bpe_free_buffer(buf: rawptr) -> void

// UTF-8 byte-level utilities
extern func bpe_text_to_byte_tokens(text: rawptr, len: i32, out_tokens: rawptr) -> void

// Integer pointer helpers (for out-parameters)
extern func ptr_create_i32() -> rawptr
extern func ptr_read_i32(p: rawptr) -> i32
extern func ptr_free(p: rawptr) -> void


// ---------------------------------------------------------------------------
// BpeTokenizer class
//
// Usage:
//   let tok: BpeTokenizer = new BpeTokenizer(256, 8192)
//   tok.train("data/tinystories_train.txt", 32000)
//   tok.save("data/tokenizer.bin")
//   tok.load("data/tokenizer.bin")
//   let ids: rawptr = tok.encode("Once upon a time")
//   let text: string = tok.decode(ids)
// ---------------------------------------------------------------------------

class BpeTokenizer {
    public let vocab_size_max: i32
    public let base_vocab_size: i32
    public mut current_vocab_size: i32
    public let vocab: rawptr      // token_string -> id
    public let merges: rawptr     // (left, right) -> merged_id

    public func new(base_vocab: i32, max_vocab: i32) -> void {
        this.base_vocab_size = base_vocab
        this.vocab_size_max = max_vocab
        this.current_vocab_size = base_vocab
        this.vocab = bpe_vocab_create()
        this.merges = bpe_merges_create()

        // Initialize base vocabulary: bytes 0..255
        // Each byte is its own token at the start
        for (i: i32 = 0; i < base_vocab; i = i + 1) {
            bpe_vocab_insert(this.vocab, "byte", i)
        }
        print("Tokenizer initialized with base vocab size:")
        print(base_vocab)
    }

    // ------------------------------------------------------------------
    // train: Learn BPE merge rules from a raw text corpus
    //   path       - path to .txt training file
    //   target_vocab- desired final vocabulary size
    // ------------------------------------------------------------------
    public func train(path: string, target_vocab: i32) -> void {
        print("BPE Training: loading corpus...")

        let len_ptr: rawptr = ptr_create_i32()
        let text_buf: rawptr = bpe_load_text_file(path, len_ptr)
        let text_len: i32 = ptr_read_i32(len_ptr)
        ptr_free(len_ptr)

        if text_len == 0 {
            print("ERROR: Could not load training corpus or file is empty.")
            bpe_free_buffer(text_buf)
            return
        }

        print("Corpus loaded. Bytes:")
        print(text_len)

        // Convert text to byte-level token sequence
        let tokens: rawptr = bpe_tokens_create(text_len + 1)
        bpe_text_to_byte_tokens(text_buf, text_len, tokens)
        bpe_free_buffer(text_buf)

        print("Initial token sequence length:")
        print(bpe_tokens_length(tokens))

        // BPE training loop: find best pair, merge, repeat
        let num_merges: i32 = target_vocab - this.base_vocab_size
        let stats: rawptr = bpe_pair_stats_create()

        for (merge_idx: i32 = 0; merge_idx < num_merges; merge_idx = merge_idx + 1) {
            // Count all adjacent pairs
            bpe_pair_stats_reset(stats)
            bpe_pair_stats_count(stats, tokens)

            // Find the most frequent pair
            let out_left: rawptr = ptr_create_i32()
            let out_right: rawptr = ptr_create_i32()
            let best_count: i32 = bpe_pair_stats_best_pair(stats, out_left, out_right)
            let best_left: i32 = ptr_read_i32(out_left)
            let best_right: i32 = ptr_read_i32(out_right)
            ptr_free(out_left)
            ptr_free(out_right)

            if best_count < 2 {
                print("No more pairs to merge. Stopping early.")
                break
            }

            // Assign new token ID for this merged pair
            let new_id: i32 = this.current_vocab_size
            this.current_vocab_size = this.current_vocab_size + 1

            // Register merge rule
            bpe_merges_insert(this.merges, best_left, best_right, new_id)
            bpe_vocab_insert(this.vocab, "merged", new_id)

            // Apply merge to token sequence
            bpe_tokens_replace_pair(tokens, best_left, best_right, new_id)

            if merge_idx % 1000 == 0 {
                print("Merge step:")
                print(merge_idx)
                print("Vocab size:")
                print(this.current_vocab_size)
                print("Token count:")
                print(bpe_tokens_length(tokens))
            }
        }

        bpe_pair_stats_destroy(stats)
        bpe_tokens_destroy(tokens)

        print("BPE training complete. Final vocab size:")
        print(this.current_vocab_size)
    }

    // ------------------------------------------------------------------
    // encode: Convert a raw string to a list of token IDs
    // Returns a rawptr to a token array (caller must free with bpe_tokens_destroy)
    // ------------------------------------------------------------------
    public func encode(text: string) -> rawptr {
        let len_ptr: rawptr = ptr_create_i32()
        let text_buf: rawptr = bpe_load_text_file(text, len_ptr)
        let text_len: i32 = ptr_read_i32(len_ptr)
        ptr_free(len_ptr)

        // Start with byte-level tokens
        let tokens: rawptr = bpe_tokens_create(text_len + 1)
        bpe_text_to_byte_tokens(text_buf, text_len, tokens)
        bpe_free_buffer(text_buf)

        // Apply all merges greedily (one pass over the merge table)
        // The merge rules are stored in insertion order, so we apply them in that order
        for (merge_id: i32 = this.base_vocab_size; merge_id < this.current_vocab_size; merge_id = merge_id + 1) {
            let left: i32 = merge_id   // simplified placeholder
            let right: i32 = merge_id  // in real impl, stored alongside merge table
            let merged: i32 = bpe_merges_lookup(this.merges, left, right)
            if merged >= 0 {
                bpe_tokens_replace_pair(tokens, left, right, merged)
            }
        }

        return tokens
    }

    // ------------------------------------------------------------------
    // save / load: Persist tokenizer state to disk
    // ------------------------------------------------------------------
    public func save(path: string) -> void {
        print("Saving tokenizer to:")
        print(path)
        bpe_save_vocab_file(this.vocab, this.merges, path)
        print("Tokenizer saved.")
    }

    public func load(path: string) -> void {
        print("Loading tokenizer from:")
        print(path)
        bpe_load_vocab_file(path, this.vocab, this.merges)
        this.current_vocab_size = bpe_vocab_size(this.vocab)
        print("Tokenizer loaded. Vocab size:")
        print(this.current_vocab_size)
    }

    // ------------------------------------------------------------------
    // get_vocab_size: Returns the current vocabulary size
    // ------------------------------------------------------------------
    public func get_vocab_size() -> i32 {
        return this.current_vocab_size
    }

    // ------------------------------------------------------------------
    // destroy: Release all memory
    // ------------------------------------------------------------------
    public func destroy() -> void {
        bpe_vocab_destroy(this.vocab)
        bpe_merges_destroy(this.merges)
        print("Tokenizer resources freed.")
    }
}
