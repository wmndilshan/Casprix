// =============================================================================
// Casprix LLM Training - DataLoader
//
// Manages tokenized binary shards for TinyStories pre-training.
// The binary format is: [header: i32 magic, i32 version, i32 num_tokens, ...]
//                        [data: i32 tokens...]
//
// In TinyStories format (llm.c style):
//   - Each shard is a flat binary file of i32 token IDs
//   - DataLoader reads batches of (batch_size x seq_len) from these shards
//   - Targets are the next-token for each position (offset by 1)
//
// Casprix FFI: All file I/O and tensor manipulation delegated to C.
// =============================================================================

extern func dataloader_create(
    path_prefix: string,
    batch_size: i32,
    seq_len: i32,
    split: i32
) -> rawptr

extern func dataloader_destroy(loader: rawptr) -> void
extern func dataloader_next_batch(loader: rawptr, out_tokens: rawptr, out_targets: rawptr) -> void
extern func dataloader_reset(loader: rawptr) -> void
extern func dataloader_num_tokens(loader: rawptr) -> i32
extern func dataloader_num_batches(loader: rawptr) -> i32

// Batch buffer management
extern func batch_buffer_create(batch: i32, seq_len: i32) -> rawptr
extern func batch_buffer_destroy(buf: rawptr) -> void


// ---------------------------------------------------------------------------
// DataLoader class wrapper
// ---------------------------------------------------------------------------

class DataLoader {
    public let handle: rawptr
    public let tokens_buf: rawptr
    public let targets_buf: rawptr
    public let batch_size: i32
    public let seq_len: i32
    public mut batch_count: i32
    public mut step: i32

    // split: 0 = train, 1 = val
    public func new(path_prefix: string, batch: i32, seq: i32, split: i32) -> void {
        this.batch_size = batch
        this.seq_len = seq
        this.step = 0
        this.handle = dataloader_create(path_prefix, batch, seq, split)
        this.tokens_buf = batch_buffer_create(batch, seq)
        this.targets_buf = batch_buffer_create(batch, seq)
        this.batch_count = dataloader_num_batches(this.handle)

        if split == 0 {
            print("Train DataLoader created.")
        } else {
            print("Val DataLoader created.")
        }
        print("  Total tokens:")
        print(dataloader_num_tokens(this.handle))
        print("  Total batches:")
        print(this.batch_count)
    }

    public func next_batch() -> void {
        dataloader_next_batch(this.handle, this.tokens_buf, this.targets_buf)
        this.step = this.step + 1
    }

    public func reset() -> void {
        dataloader_reset(this.handle)
        this.step = 0
    }

    public func destroy() -> void {
        batch_buffer_destroy(this.tokens_buf)
        batch_buffer_destroy(this.targets_buf)
        dataloader_destroy(this.handle)
        print("DataLoader resources freed.")
    }
}
