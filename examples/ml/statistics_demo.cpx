// Statistics Demo - Descriptive Statistics and Random Numbers

import "lib/math/Vector.cpx"
import "lib/math/Stats.cpx"

func main() -> void {
    print("=== Statistics Demo ===");
    
    // Create dataset
    data: Vector = new Vector(10);
    
    print("Generating random data...");
    Stats.setSeed(12345);
    
    for (i: int = 0; i < 10; i = i + 1) {
        val: float = Stats.randomNormal(100.0, 15.0);
        data.set(i, val);
        print(val);
    }
    
    // Descriptive statistics
    print("");
    print("Descriptive Statistics:");
    
    mean: float = Stats.mean(data);
    print("Mean:");
    print(mean);
    
    median: float = Stats.median(data);
    print("Median:");
    print(median);
    
    stddev: float = Stats.stdDev(data);
    print("Standard Deviation:");
    print(stddev);
    
    minVal: float = Stats.min(data);
    print("Min:");
    print(minVal);
    
    maxVal:float = Stats.max(data);
    print("Max:");
    print(maxVal);
    
    // Probability distributions
    print("");
    print("Normal Distribution:");
    
    x: float = 100.0;
    pdf: float = Stats.normalPDF(x, 100.0, 15.0);
    print("PDF at x=100:");
    print(pdf);
    
    cdf: float = Stats.normalCDF(x, 100.0, 15.0);
    print("CDF at x=100:");
    print(cdf);
    
    // Random number generation
    print("");
    print("Random Numbers:");
    
    for (i: int = 0; i < 5; i = i + 1) {
        uniform: float = Stats.randomUniform();
        print("Uniform [0,1):");
        print(uniform);
        
        normal: float = Stats.randomNormal(0.0, 1.0);
        print("Normal(0,1):");
        print(normal);
    }
    
    // Cleanup
    data.destroy();
    
    print("");
    print("Demo complete!");
}
