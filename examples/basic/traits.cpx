// Casprix Language Examples - Traits
// Planned trait/impl surface demo.
// The parser accepts the syntax, but impl-method wiring is still incomplete in
// the semantic layer, so this file is intentionally not a stable runnable sample.

print("=== Trait System Example ===")

trait Printable {
    func toString() -> string
}

trait Comparable {
    func compareTo(other: Point) -> int
}

class Point {
    let x: int
    let y: int

    func new(x: int, y: int) {
        this.x = x
        this.y = y
    }
}

impl Printable for Point {
    func toString() -> string {
        return "Point(" + this.x + ", " + this.y + ")"
    }
}

impl Comparable for Point {
    func compareTo(other: Point) -> int {
        let d1 = this.x * this.x + this.y * this.y
        let d2 = other.x * other.x + other.y * other.y

        if d1 < d2 {
            return -1
        }

        if d1 > d2 {
            return 1
        }

        return 0
    }
}

let p1 = new Point(3, 4)
let p2 = new Point(1, 2)

print(p1.toString())
print(p2.toString())
print(p1.compareTo(p2))
print("Trait example completed")
