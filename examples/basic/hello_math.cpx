// Example: Using Math library
import "lib/math/math.cpx";

print("Math Library Demo");
print("=================");

x: int = 5;
y: int = 3;

print("Power(5, 3) =");
print(Power(x, y));

print("Factorial(5) =");
print(Factorial(x));

print("GCD(15, 25) =");
print(GCD(15, 25));

print("Is 17 prime?");
print(IsPrime(17));

print("Fibonacci(10) =");
print(Fibonacci(10));



