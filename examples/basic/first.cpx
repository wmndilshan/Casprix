// import IO module
// import "lib/io.cpx"

// Recursive factorial
func factorialRecursive(n: int) -> int {
    if n <= 1 {
        return 1;
    } else {
        return n * factorialRecursive(n - 1);
    }
}

// Iterative factorial
func factorialIterative(n: int) -> int {
    result: int = 1;
    for (i: int = 2; i <= n; i = i + 1) {
        result = result * i;
    }
    return result;
}

// Test both implementations
print("Factorial Comparison:");
for (i: int = 1; i <= 10; i = i + 1) {
    recursive: int = factorialRecursive(i);
    iterative: int = factorialIterative(i);
    
    print("n =");
    print(i);
    print("Recursive:");
    print(recursive);
    print("Iterative:");
    print(iterative);
}
