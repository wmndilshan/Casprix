// Casprix Language Examples - Generics

print("=== Generic List ===")

// Generic List class
class List<T> {
    mut items: Array<T>
    mut count: int
    mut capacity: int

    func new() {
        this.count = 0
        this.capacity = 10
        this.items = NewArray<T>(10)
    }

    func add(item: T) {
        if this.count >= this.capacity {
            this.resize()
        }
        this.items[this.count] = item
        this.count = this.count + 1
    }

    func get(index: int) -> T {
        if index < 0 Or index >= this.count {
            Error("Index out of bounds")
        }
        return this.items[index]
    }

    func size() -> int {
        return this.count
    }

    func resize() {
        this.capacity = this.capacity * 2
        let newItems = NewArray<T>(this.capacity)
        for i = 0 to this.count {
            newItems[i] = this.items[i]
        }
        this.items = newItems
    }
}

// Test with integers
let numbers = new List<int>()
numbers.add(1)
numbers.add(2)
numbers.add(3)

print("Numbers: " + numbers.get(0))  // 1
print("Size: " + numbers.size())     // 3

// Test with strings
print("\n=== Generic with Strings ===")

let names = new List<string>()
names.add("Alice")
names.add("Bob")
names.add("Charlie")

print("Names: " + names.get(0))      // Alice
print("Size: " + names.size())       // 3

// Generic Pair
print("\n=== Generic Pair ===")

class Pair<K, V> {
    let key: K
    let value: V

    func new(k: K, v: V) {
        this.key = k
        this.value = v
    }

    func getKey() -> K {
        return this.key
    }

    func getValue() -> V {
        return this.value
    }
}

let pair = new Pair<string, int>("age", 25)
print("Key: " + pair.getKey())       // age
print("Value: " + pair.getValue())   // 25

// Generic function
print("\n=== Generic Function ===")

func swap<T>(a: T, b: T) -> Pair<T, T> {
    return new Pair<T, T>(b, a)
}

let swapped = swap<int>(1, 2)
print("Swapped: " + swapped.getKey() + ", " + swapped.getValue())  // 2, 1

print("\n✓ All generic examples completed!")
