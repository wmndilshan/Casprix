// Comprehensive MIR pipeline test

// Simple arithmetic
func add(a: int, b: int) -> int {
    return a + b;
}

// Control flow: if/else
func max(a: int, b: int) -> int {
    if a > b {
        return a;
    } else {
        return b;
    }
}

// Loop: while
func sum_to(n: int) -> int {
    total: int = 0;
    i: int = 1;
    while i <= n {
        total = total + i;
        i = i + 1;
    }
    return total;
}

// Loop: for
func factorial(n: int) -> int {
    result: int = 1;
    for (i: int = 2; i <= n; i = i + 1) {
        result = result * i;
    }
    return result;
}

// Nested control flow
func classify(n: int) -> int {
    if n > 0 {
        if n > 100 {
            return 2;
        } else {
            return 1;
        }
    } else {
        return 0;
    }
}

// Entry point
func main() -> int {
    x: int = add(10, 20);
    print(x);
    
    y: int = max(42, 17);
    print(y);

    s: int = sum_to(10);
    print(s);

    f: int = factorial(5);
    print(f);

    c: int = classify(50);
    print(c);

    return 0;
}
