{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Casprix",
    "scopeName": "source.cpx",
    "fileTypes": [
        "cpx",
        "nd"
    ],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#char_literals"
        },
        {
            "include": "#annotations"
        },
        {
            "include": "#keywords_control"
        },
        {
            "include": "#keywords_declaration"
        },
        {
            "include": "#keywords_modifier"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#builtin_types"
        },
        {
            "include": "#builtin_functions"
        },
        {
            "include": "#function_definition"
        },
        {
            "include": "#function_call"
        },
        {
            "include": "#type_annotation"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#delimiters"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.cpx",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.cpx",
                    "begin": "/\\*",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.begin.cpx"
                        }
                    },
                    "end": "\\*/",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.end.cpx"
                        }
                    }
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.cpx",
            "begin": "\"",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.definition.string.begin.cpx"
                }
            },
            "end": "\"",
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.string.end.cpx"
                }
            },
            "patterns": [
                {
                    "name": "constant.character.escape.cpx",
                    "match": "\\\\(n|t|r|\\\\|\"|0|x[0-9a-fA-F]{2})"
                },
                {
                    "name": "variable.other.interpolated.cpx",
                    "match": "\\$\\{[^}]+\\}"
                }
            ]
        },
        "char_literals": {
            "name": "string.quoted.single.cpx",
            "match": "'(\\\\.|[^\\\\'])'",
            "captures": {
                "0": {
                    "name": "constant.character.cpx"
                }
            }
        },
        "annotations": {
            "name": "entity.name.tag.annotation.cpx",
            "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        },
        "keywords_control": {
            "name": "keyword.control.cpx",
            "match": "\\b(if|else|elif|for|while|return|break|continue|match|in|async|await|spawn|try|throw|catch|finally|import|alloc)\\b"
        },
        "keywords_declaration": {
            "name": "keyword.declaration.cpx",
            "match": "\\b(func|class|struct|enum|union|trait|impl|new|type)\\b"
        },
        "keywords_modifier": {
            "name": "storage.modifier.cpx",
            "match": "\\b(let|const|mut|static|public|private|protected|abstract|extern|extends|implements|move|copy|where|unsafe|dyn|lambda)\\b"
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.cpx",
                    "match": "\\b(true|false|null|nil|this|self|super)\\b"
                }
            ]
        },
        "builtin_types": {
            "name": "support.type.cpx",
            "match": "\\b(i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|f16|f32|f64|bf16|int|float|string|strbuf|bool|void|char|array|slice|ptr|rawptr|ref|tensor|vec2|vec3|vec4|vec8|vec16|mat2|mat3|mat4|Int|Float|String|Bool|Void)\\b"
        },
        "builtin_functions": {
            "name": "support.function.builtin.cpx",
            "match": "\\b(print|println|printf|sprintf|len|sizeof|typeof|assert|panic|exit|alloc|free|copy|move|drop|clone|cast|transmute)\\b(?=\\s*\\()"
        },
        "function_definition": {
            "patterns": [
                {
                    "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.cpx"
                        },
                        "2": {
                            "name": "entity.name.function.cpx"
                        }
                    }
                }
            ]
        },
        "function_call": {
            "name": "entity.name.function.cpx",
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        },
        "type_annotation": {
            "patterns": [
                {
                    "match": ":\\s*([A-Z][a-zA-Z0-9_]*(?:<[^>]*>)?)",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.cpx"
                        }
                    }
                },
                {
                    "match": "->\\s*([a-zA-Z_][a-zA-Z0-9_]*(?:<[^>]*>)?)",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.return.cpx"
                        }
                    }
                },
                {
                    "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b",
                    "name": "entity.name.type.cpx"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.cpx",
                    "match": "\\b0x[0-9a-fA-F_]+\\b"
                },
                {
                    "name": "constant.numeric.binary.cpx",
                    "match": "\\b0b[01_]+\\b"
                },
                {
                    "name": "constant.numeric.octal.cpx",
                    "match": "\\b0o[0-7_]+\\b"
                },
                {
                    "name": "constant.numeric.float.cpx",
                    "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?\\b"
                },
                {
                    "name": "constant.numeric.integer.cpx",
                    "match": "\\b\\d[\\d_]*\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.logical.word.cpx",
                    "match": "\\b(or|and|not|is|as|in)\\b"
                },
                {
                    "name": "keyword.operator.range.cpx",
                    "match": "\\.\\.|\\.\\.="
                },
                {
                    "name": "keyword.operator.assignment.compound.cpx",
                    "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>="
                },
                {
                    "name": "keyword.operator.assignment.cpx",
                    "match": ":=|="
                },
                {
                    "name": "keyword.operator.comparison.cpx",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.arithmetic.cpx",
                    "match": "\\+|-|\\*|/|%|\\^"
                },
                {
                    "name": "keyword.operator.logical.cpx",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.bitwise.cpx",
                    "match": "&|\\||~|<<|>>"
                },
                {
                    "name": "keyword.operator.arrow.cpx",
                    "match": "->|=>"
                },
                {
                    "name": "keyword.operator.dereference.cpx",
                    "match": "\\*(?=[a-zA-Z_(])"
                },
                {
                    "name": "keyword.operator.address.cpx",
                    "match": "&(?=[a-zA-Z_(])"
                }
            ]
        },
        "delimiters": {
            "patterns": [
                {
                    "name": "punctuation.separator.comma.cpx",
                    "match": ","
                },
                {
                    "name": "punctuation.terminator.statement.cpx",
                    "match": ";"
                },
                {
                    "name": "punctuation.separator.colon.cpx",
                    "match": ":"
                },
                {
                    "name": "punctuation.section.parens.begin.cpx",
                    "match": "\\("
                },
                {
                    "name": "punctuation.section.parens.end.cpx",
                    "match": "\\)"
                },
                {
                    "name": "punctuation.section.braces.begin.cpx",
                    "match": "\\{"
                },
                {
                    "name": "punctuation.section.braces.end.cpx",
                    "match": "\\}"
                },
                {
                    "name": "punctuation.section.brackets.begin.cpx",
                    "match": "\\["
                },
                {
                    "name": "punctuation.section.brackets.end.cpx",
                    "match": "\\]"
                }
            ]
        }
    }
}