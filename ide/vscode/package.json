{
    "name": "casprix-language",
    "displayName": "Casprix 👻 Language",
    "description": "Language server (live diagnostics, document symbols, go-to-definition), syntax highlighting, and auto-complete for the Casprix programming language (.cpx).",
    "version": "1.2.0",
    "publisher": "casprix-dev",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/wmndilshan/casprix.git"
    },
    "icon": "icons/ghost-emoji.png",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Linters"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:casprix"
    ],
    "contributes": {
        "commands": [
            {
                "command": "casprix.restartLsp",
                "title": "Casprix: Restart Language Server",
                "category": "Casprix"
            }
        ],
        "languages": [
            {
                "id": "casprix",
                "aliases": [
                    "Casprix 👻",
                    "Casprix",
                    "casprix",
                    "cpx"
                ],
                "extensions": [
                    ".cpx",
                    ".nd"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/ghost-emoji.png",
                    "dark": "./icons/ghost-emoji.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "casprix",
                "scopeName": "source.cpx",
                "path": "./casprix.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "casprix",
                "path": "./snippets.json"
            }
        ],
        "configuration": {
            "title": "Casprix",
            "properties": {
                "casprix.enableLsp": {
                    "type": "boolean",
                    "default": true,
                    "description": "Use the casprix-lsp language server for diagnostics, document symbols, and go-to-definition. When off (or the server is not found), the extension falls back to `casprix --check-only`."
                },
                "casprix.lspPath": {
                    "type": "string",
                    "default": "casprix-lsp",
                    "description": "Path to the casprix-lsp executable. A bare name is looked up on PATH; the extension also probes <workspace>/build/casprix-lsp."
                },
                "casprix.compilerPath": {
                    "type": "string",
                    "default": "casprix",
                    "description": "Path to the Casprix compiler executable (used only for the --check-only fallback when the LSP is unavailable)."
                },
                "casprix.checkOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run the compiler error checker on file save."
                },
                "casprix.checkOnType": {
                    "type": "boolean",
                    "default": false,
                    "description": "Run the compiler error checker while typing (may be slow)."
                },
                "casprix.checkDelay": {
                    "type": "number",
                    "default": 800,
                    "description": "Delay in milliseconds before running the error checker (when checkOnType is enabled)."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "echo 'No build step required'",
        "package": "vsce package"
    },
    "devDependencies": {
        "@vscode/vsce": "^3.0.0"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    }
}
