// Linear-view VIOLATION: view `v` escapes via RETURN but its parent `s`
// is a local parameter that never escapes further than the function
// boundary.  The escape-propagation pass must reject this at the
// AST -> MIR boundary before any MIR is built.
class StringView {
    public let data: int;
    public let len: int;

    func StringView(src: string) -> void {
        this.data = 0;
        this.len = 0;
    }
}

func leak(s: string) -> StringView {
    let v: StringView = new StringView(s);
    return v;
}

func main() -> int {
    return 0;
}

main();
