# =============================================================
# Casprix — .gitignore
# =============================================================

# -------------------------------------------------------------
# Build outputs
# -------------------------------------------------------------
/build/
/bin/
/obj/
/out/
# Any out-of-tree CMake/Ninja build directory (build-codex-verify,
# build-codex-android, build-release, etc.).  These are per-developer
# scratch dirs and must never be tracked.
build-*/

# CMake artifacts
CMakeCache.txt
# CMake writes `<file>.tmp<hex>` siblings during atomic-rename updates;
# these regularly litter `git status` on Windows when a build is racing
# a status check.  Match the hex-suffixed form explicitly.
CMakeCache.txt.tmp*
cmake_install.cmake.tmp*
compile_commands.json.tmp*
CTestTestfile.cmake.tmp*
build.ninja.tmp*
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/
*.cmake
!CMakeLists.txt

# Ninja state files (generator output, per-build)
.ninja_log
.ninja_log.restat
.ninja_deps
build.ninja
build.ninja.touch

# Compiled object code & libraries
*.o
*.obj
*.a
*.lib
*.dll
*.so
*.so.*
*.dylib
*.pdb
*.ilk
*.exp
*.map

# Executables (keep tracked .asm sources)
*.exe
!runtime/ai/llm/ops_avx2.asm

# Pre-compiled headers
*.gch
*.pch

# NASM intermediate
*.obj.asm

# -------------------------------------------------------------
# Language & compiler artifacts
# -------------------------------------------------------------
# Generated C backend output
/tmp_c_out/
*.cpx.c
*.nd.c
# Double/triple-extension artifacts from repeated `casprix foo.c` compile attempts
# (produces foo.c.c, foo.c.c.c, ...).
*.c.c
*.c.c.c

# Generated assembly output
*.s
*.asm_out

# Legacy VM bytecode / JIT package output (emitted next to the source by
# --vm / --jit; never committed).
*.cpxbc
*.cpxjit
*.cpxv
*.cpxj

# -------------------------------------------------------------
# Test & coverage artifacts
# -------------------------------------------------------------
/tests/build/
Testing/
CTestTestfile.cmake
coverage/
*.gcno
*.gcda
*.lcov
lcov.info

# -------------------------------------------------------------
# Data, model weights, and training artifacts
# -------------------------------------------------------------
/data/
/checkpoints/
/datasets/
*.bin
*.ckpt
*.safetensors
*.pt
*.pth
*.npy
*.npz
*.h5

# -------------------------------------------------------------
# Package manager cache
# -------------------------------------------------------------
/.casprix/
/casprix_modules/
casper.lock

# -------------------------------------------------------------
# IDE & editor
# -------------------------------------------------------------
# Visual Studio
.vs/
*.user
*.suo
*.ncb
*.sdf
*.opensdf
*.aps
ipch/

# VS Code (keep shared settings, ignore personal/generated)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.history/
*.code-workspace

# JetBrains (CLion, IntelliJ, etc.)
.idea/
cmake-build-*/
*.iml

# Cursor (keep shared rules under .cursor/rules/, ignore everything else)
.cursor/*
!.cursor/rules/
.cursorignore
.cursorrules

# Other AI / agent editors and CLIs
.windsurf/
.antigravity/
.zed/
.aider*
.continue/
.cody/
.tabnine/
.codeium/
.sourcegraph/
.gemini/
.opencode/
.goose/
.roo/
.cline/
.kilocode/
.pearai/
.trae/
.void/
*.aider.chat.history.md
.ai/
.llm/

# Vim / Neovim
*.swp
*.swo
.netrwhist
Session.vim
.vim/

# Emacs
*~
\#*\#
.#*

# -------------------------------------------------------------
# Claude Code / Codex / agent metadata
# -------------------------------------------------------------
# Claude Code: keep a committed .claude/ config if one exists, ignore the
# per-developer and generated parts.
.claude/worktrees/
.claude/settings.local.json
.claude/projects/
.claude/todos/
.claude/statsig/
.claude/shell-snapshots/
.claude/history.jsonl
.claude/.credentials.json
CLAUDE.local.md

# OpenAI Codex CLI
.codex
.codex/
AGENTS.local.md

# Aider
.aider.tags.cache*
.aider.conf.yml

# -------------------------------------------------------------
# VS Code extension build
# -------------------------------------------------------------
ide/vscode/node_modules/
ide/vscode/out/
ide/vscode/dist/
*.vsix

# -------------------------------------------------------------
# Python (tools/training scripts)
# -------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.Python
.venv/
venv/
env/
pip-log.txt
*.egg-info/
.eggs/
dist/

# -------------------------------------------------------------
# External toolchains (large binaries — install separately)
# -------------------------------------------------------------
tools/build-tools/
tools/android/gn.exe
tools/android/*.log
tools/android/platform-tools/
tools/android/ndk/
tools/android/sdk/

# third-party prebuilt binaries (source headers are tracked)
third_party/skia/*.a
third_party/skia/*.lib
third_party/skia/*.dll
third_party/skia/*.so
third_party/skia-src/out/

# -------------------------------------------------------------
# Externally-cloned git repositories checked out inside the tree
# -------------------------------------------------------------
# These are separate upstream projects cloned in for local reference/experiments.
# They carry their own .git/ and must never be committed here (git would nest
# them as broken gitlinks). Vendor real dependencies under third_party/ as plain
# source, or add them as proper submodules — not loose clones.
/rbpf/
# Any directory that is itself a git checkout (defensive; the entry above is the
# known one). A nested .git dir is the tell-tale.
**/vendor-src/
**/.external/

# -------------------------------------------------------------
# Android build
# -------------------------------------------------------------
android-demo-app/.gradle/
android-demo-app/build/
android-demo-app/app/build/
android-demo-app/local.properties
*.apk
*.aab

# -------------------------------------------------------------
# Logs & temp files
# -------------------------------------------------------------
*.log
*.tmp
# Matches `foo.tmp1234ab` style atomic-write temp files (CMake, editors).
*.tmp[0-9a-fA-F]*
*.bak
*.backup
*.orig
*.rej
*.patch
crash_*.txt
sanitizer_*.log
# Hand-captured build/debug logs that don't use the .log extension.
build_log*.txt
build_log*
*_output.log
debug_*.txt
strace*.log
strace.out
# Windows `nul` sink accidentally created by `... > nul` on a Unix shell.
/nul
nul.txt

# -------------------------------------------------------------
# Generated / one-off Markdown reports (real docs are tracked explicitly)
# -------------------------------------------------------------
# Agent- and tool-generated write-ups (audits, inventories, session summaries,
# handoffs) tend to accumulate. Ignore them by name; the curated docs in the
# repo root and docs/ are added individually and are unaffected.
*_report.md
*_REPORT.md
*_inventory*.md
*_INVENTORY*.md
*_handoff*.md
*_HANDOFF*.md
*_summary.md
*_SUMMARY.md
*_audit*.md
*_AUDIT*.md
*_notes.md
*-notes.md
SCRATCH*.md
NOTES.md
TODO.local.md
docs/**/*_report.md
docs/**/*_inventory*.md
docs/casprix_inventory_report.md

# -------------------------------------------------------------
# OS metadata
# -------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -------------------------------------------------------------
# Local scratch files (test sources and binaries)
# -------------------------------------------------------------
#
# CONVENTION: put ALL manual/scratch experiments — one-off .cpx snippets,
# hand-compiled C, throwaway binaries — under scratch/ (see scratch/README.md).
# Everything in scratch/ except its README is ignored, so nothing there ever
# needs individual cleanup.
/scratch/*
!/scratch/README.md

# Historical root-level scratch names (kept so an old checkout stays clean).
# New scratch work should live in scratch/, not here.
/hello.c
/hello_c_output.c
/hello_c_output_bin
/hello_core
/my_hello.c*
/test_args.c
/test_print*
/test_wrapper.c
/train_llm*
/examples/llm_training/train_llm

# Ad-hoc experiments in the repo ROOT — compiled binaries (the compiler
# defaults the -o name to the source stem, so they have no extension on Unix)
# AND their stray .cpx / .c sources. Real tests live in tests/; real scratch
# work goes in scratch/. Anything matching these at the root is throwaway.
# Anchored with a leading slash so genuine files with these names in subdirs
# (e.g. tests/compiler/test_*.cpx) are completely unaffected.
/test_*
/debug_*
/*_test
/*_test.*
/*_bench
/*_bench.*
/fib
/nested
/twovar
/sum
/u_c
/hot3
/rocap
/bin_repro
/first
/first_*
