// TypeScript/Swift/Rust-style `else if` chains.
func classify(value: int) -> int {
    if value < 0 {
        return -1;
    } else if value == 0 {
        return 0;
    } else if value < 10 {
        return 1;
    } else {
        return 2;
    }
}

func main() -> int {
    return classify(7) - 1;
}
