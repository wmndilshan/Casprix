class Foo {
    mut val: int
    func set_val(v: int) {
        this.val = v
    }
}

func test_borrow(cond: bool) -> int {
    let f = new Foo()
    f.set_val(42)

    // Path-sensitive: the then arm moves and returns, so the join only
    // sees the else path where `f` remains owned.
    if cond {
        let y = move f
        return y.val
    } else {
        f.set_val(10)
    }

    f.set_val(20)
    return 0
}

func main() -> int {
    test_borrow(true)
    return 0
}

main()
