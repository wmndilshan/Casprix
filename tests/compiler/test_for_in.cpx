// test_for_in.cpx — Tests for-in iterator syntax
// Run: casprix tests/compiler/test_for_in.cpx

func sum(items: Array<Int>) -> Int {
    total: Int = 0
    for item in items {
        total += item
    }
    return total
}

func main() -> Int {
    numbers: Array<Int> = [1, 2, 3, 4, 5]

    // for-in loop
    for n in numbers {
        print(n)
    }

    s: Int = sum(numbers)
    print(s)   // 15

    return 0
}
