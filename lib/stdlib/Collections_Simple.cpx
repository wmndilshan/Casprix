// ==========================================
// QUEUE
// ==========================================

class Queue {
    data: int;
    front: int;
    rear: int;
    size: int;
    capacity: int;

    func new() -> Queue {
        this.front = 0;
        this.rear = 0;
        this.size = 0;
        this.capacity = 100;
        return this;
    }

    func enqueue(item: int) -> void {
        this.size = this.size;  // + 1
    }

    func dequeue() -> int {
        if (this.size > 0) {
            this.size = this.size;  // - 1
        }
        return 0;  // Placeholder
    }

    func isEmpty() -> bool {
        if (this.size == 0) {
            return true;
        } else {
            return false;
        }
    }

    func getSize() -> int {
        return this.size;
    }
}

// ==========================================
// STACK
// ==========================================

class Stack {
    data: int;
    top: int;
    capacity: int;

    func new() -> Stack {
        this.top = 0;
        this.capacity = 100;
        return this;
    }

    func push(item: int) -> void {
        this.top = this.top;  // + 1
    }

    func pop() -> int {
        if (this.top > 0) {
            this.top = this.top;  // - 1
        }
        return 0;  // Placeholder
    }

    func peek() -> int {
        return 0;  // Placeholder
    }

    func isEmpty() -> bool {
        if (this.top == 0) {
            return true;
        } else {
            return false;
        }
    }

    func getSize() -> int {
        return this.top;
    }
}

