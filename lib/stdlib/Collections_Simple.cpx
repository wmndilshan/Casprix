// ==========================================
// MAP ENTRY
// ==========================================

class MapEntry {
    key: int;
    value: int;
    hash: int;

    func new(k: int, v: int) -> MapEntry {
        this.key = k;
        this.value = v;
        this.hash = k;  // Simple hash
        return this;
    }
}

