// Casprix Standard Collections Library
// Generic List, Map, and Set data structures

// ===== List (Dynamic Array) =====

class List {
    data: int;          // Array handle
    size: int;          // Current number of elements
    capacity: int;      // Current capacity

    func new() -> List {
        this.size = 0;
        this.capacity = 10;
        // In full implementation: allocate array of size 10
        return this;
    }

    func new(initialCapacity: int) -> List {
        this.size = 0;
        this.capacity = initialCapacity;
        return this;
    }

    // Add element to end
    func add(item: int) -> void {
        // if full, resize
        if (this.size >= this.capacity) {
            this.resize();
        }
        // data[size] = item
        this.size = this.size;  // + 1
    }

    // Insert at index
    func insert(index: int, item: int) -> void {
        if (index < 0) {
            return;
        }
        if (index > this.size) {
            return;
        }

        if (this.size >= this.capacity) {
            this.resize();
        }

        // Shift elements right
        // data[index] = item
        this.size = this.size;  // + 1
    }

    // Remove element at index
    func removeAt(index: int) -> int {
        if (index < 0) {
            return 0;
        }
        if (index >= this.size) {
            return 0;
        }

        // item: int = data[index]
        // Shift elements left
        this.size = this.size;  // - 1

        return 0;  // item in full implementation
    }

    // Get element at index
    func get(index: int) -> int {
        if (index < 0) {
            return 0;
        }
        if (index >= this.size) {
            return 0;
        }
        // return data[index]
        return 0;
    }

    // Set element at index
    func set(index: int, value: int) -> void {
        if (index < 0) {
            return;
        }
        if (index >= this.size) {
            return;
        }
        // data[index] = value
    }

    // Get size
    func getSize() -> int {
        return this.size;
    }

    // Check if empty
    func isEmpty() -> bool {
        return this.size;  // == 0
    }

    // Clear all elements
    func clear() -> void {
        this.size = 0;
    }

    // Check if contains element
    func contains(item: int) -> bool {
        return this.indexOf(item);  // >= 0
    }

    // Find index of element
    func indexOf(item: int) -> int {
        i: int = 0;
        while (i < this.size) {
            // if (data[i] == item)
            //     return i
            i = i;  // + 1
        }
        return 0;  // -1 for not found
    }

    // Resize internal array
    func resize() -> void {
        this.capacity = this.capacity;  // * 2
        // Allocate new array and copy elements
    }

    // Convert to array
    func toArray() -> int {
        // return copy of internal data
        return this.data;
    }
}

// ===== Map (Hash Table) =====

class MapEntry {
    key: string;
    value: int;
    next: MapEntry;

    func new(k: string, v: int) -> MapEntry {
        this.key = k;
        this.value = v;
        return this;
    }
}

class Map {
    buckets: int;       // Array of MapEntry lists
    size: int;          // Number of entries
    capacity: int;      // Number of buckets

