// Core Library - Fundamental types and utilities
// This module provides core functionality for the Casprix language

// Type definitions and constants
// true and false are built-in keywords

// Core utility functions
func Abs(n: int) -> int {
    if n < 0 {
        return -n;
    }
    return n;
}

func Max(a: int, b: int) -> int {
    if a > b {
        return a;
    }
    return b;
}

func Min(a: int, b: int) -> int {
    if a < b {
        return b;
    }
    return a;
}

// Type checking utilities
func IsZero(n: int) -> bool {
    return n == 0;
}

func IsPositive(n: int) -> bool {
    return n > 0;
}

func IsNegative(n: int) -> bool {
    return n < 0;
}



