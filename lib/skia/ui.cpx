// ========================================================================
// Card Helper — Wraps content in a styled card
// ========================================================================

class Card {
    handle: i64;

    func new() -> void {
        this.handle = widget_container()
        ui_require_state(this.handle != 0, "Failed to create Card")
        sg_style_card(this.handle)
    }

    func add(child: i64) -> void {
        ui_require_handle(this.handle, "Card")
        ui_require_handle(child, "Card child")
        sg_node_add_child(this.handle, child)
    }

    func set_padding(p: float) -> void {
        ui_require_handle(this.handle, "Card")
        ui_require_non_negative(p, "Card padding")
        sg_style_set_padding_uniform(this.handle, p)
    }

    func set_background(color: i64) -> void {
        ui_require_handle(this.handle, "Card")
        sg_style_set_background(this.handle, color)
    }

    func set_border(color: i64, width: float, radius: float) -> void {
        ui_require_handle(this.handle, "Card")
        ui_require_non_negative(width, "Card border width")
        ui_require_non_negative(radius, "Card border radius")
        sg_style_set_border(this.handle, color, width, radius)
    }

    func set_elevation(e: i64) -> void {
        ui_require_handle(this.handle, "Card")
        ui_require_non_negative_i64(e, "Card elevation")
        sg_style_elevated(this.handle, e)
    }

    func set_shadow(ox: float, oy: float, blur: float, color: i64) -> void {
        ui_require_handle(this.handle, "Card")
        ui_require_non_negative(blur, "Card shadow blur")
        sg_style_set_shadow(this.handle, ox, oy, blur, color)
    }

    func set_opacity(o: float) -> void {
        ui_require_handle(this.handle, "Card")
        ui_require(o >= 0.0 && o <= 1.0, "Card opacity must be between 0 and 1")
        sg_style_set_opacity(this.handle, o)
    }

    func set_min_size(w: float, h: float) -> void {
        ui_require_handle(this.handle, "Card")
        ui_require_non_negative(w, "Card minimum width")
        ui_require_non_negative(h, "Card minimum height")
        sg_node_set_min_size(this.handle, w, h)
    }

    func destroy() -> void {
        if this.handle != 0 {
            sg_node_destroy(this.handle)
            this.handle = 0
        }
    }
}

