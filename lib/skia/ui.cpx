        ui_require_state(this.handle != 0, "Failed to create Separator")
    }

    func destroy() -> void {
        if this.handle != 0 {
            sg_node_destroy(this.handle)
            this.handle = 0
        }
    }
}

class Spacer {
    handle: i64;

    func new(grow: float) -> void {
        ui_require_non_negative(grow, "Spacer grow")
        this.handle = widget_spacer(grow)
        ui_require_state(this.handle != 0, "Failed to create Spacer")
