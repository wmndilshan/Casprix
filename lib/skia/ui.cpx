// Skia UI — High-level OOP wrappers for Casprix
// // Provides App, Column, Row, Button, Text, TextInput, etc. as
// classes wrapping the low-level extern functions from skia.cpx.

import "lib/skia/skia"

// ========================================================================
// Application
// ========================================================================

class App {
    handle: i64;
    root_handle: i64;
    font_handle: i64;

    func new(title: string, width: i64, height: i64) -> void {
        this.handle = sg_app_create(title, width, height)
        this.font_handle = skia_font_create("Segoe UI", 14.0)
    }

    func set_root(node: i64) -> void {
        this.root_handle = node
        sg_app_set_root(this.handle, node)
    }

    func run() -> void {
        sg_app_run(this.handle)
    }

    func quit() -> void {
        sg_app_quit(this.handle)
    }

    func get_font() -> i64 {
        return this.font_handle
    }

    func set_fps(fps: i64) -> void {
        sg_app_set_fps(this.handle, fps)
    }

    func get_anim_pool() -> i64 {
        return sg_app_get_animations(this.handle)
    }

    func fade_in(node: i64, duration: float) -> i64 {
        return sg_fade_in(sg_app_get_animations(this.handle), node, duration)
    }

    func fade_out(node: i64, duration: float) -> i64 {
        return sg_fade_out(sg_app_get_animations(this.handle), node, duration)
    }

    func invalidate() -> void {
        sg_app_invalidate(this.handle)
    }

    func destroy() -> void {
        sg_app_destroy(this.handle)
    }
}

// ========================================================================
// Layout Containers
// ========================================================================

class Column {
    handle: i64;

    func new(spacing: float) -> void {
        this.handle = widget_column(spacing)
    }

    func add(child: i64) -> void {
        sg_node_add_child(this.handle, child)
    }

    func set_padding(p: float) -> void {
        sg_style_set_padding_uniform(this.handle, p)
    }

    func set_background(color: i64) -> void {
        sg_style_set_background(this.handle, color)
    }

    func set_border(color: i64, width: float, radius: float) -> void {
        sg_style_set_border(this.handle, color, width, radius)
    }

    func set_min_size(w: float, h: float) -> void {
        sg_node_set_min_size(this.handle, w, h)
    }

    func set_max_size(w: float, h: float) -> void {
        sg_node_set_max_size(this.handle, w, h)
    }

    func set_flex_grow(grow: float) -> void {
        sg_node_set_flex_grow(this.handle, grow)
    }

    func set_align_self(align: i64) -> void {
        sg_node_set_align_self(this.handle, align)
    }

    func set_align_items(align: i64) -> void {
        sg_node_set_align_items(this.handle, align)
    }

    func set_visible(v: i64) -> void {
        sg_node_set_visible(this.handle, v)
    }
}

class Row {
    handle: i64;

    func new(spacing: float) -> void {
        this.handle = widget_row(spacing)
    }

    func add(child: i64) -> void {
        sg_node_add_child(this.handle, child)
    }

    func set_padding(p: float) -> void {
        sg_style_set_padding_uniform(this.handle, p)
    }

    func set_background(color: i64) -> void {
        sg_style_set_background(this.handle, color)
    }

    func set_min_size(w: float, h: float) -> void {
        sg_node_set_min_size(this.handle, w, h)
    }

    func set_flex_grow(grow: float) -> void {
        sg_node_set_flex_grow(this.handle, grow)
    }

    func set_align_self(align: i64) -> void {
        sg_node_set_align_self(this.handle, align)
    }

    func set_align_items(align: i64) -> void {
        sg_node_set_align_items(this.handle, align)
    }

    func set_visible(v: i64) -> void {
        sg_node_set_visible(this.handle, v)
