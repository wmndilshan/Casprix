        ui_require_handle(this.handle, "ScrollView")
        ui_require_non_negative(grow, "ScrollView flex grow")
        sg_node_set_flex_grow(this.handle, grow)
    }

    func set_align_self(align: Alignment) -> void {
        ui_require_handle(this.handle, "ScrollView")
        sg_node_set_align_self(this.handle, align.value)
    }

    func set_background(color: i64) -> void {
        ui_require_handle(this.handle, "ScrollView")
        sg_style_set_background(this.handle, color)
    }

    func destroy() -> void {
        if this.handle != 0 {
            sg_node_destroy(this.handle)
            this.handle = 0
        }
    }
}

// ========================================================================
// ProgressBar
// ========================================================================

class ProgressBar {
    handle: i64;
    min_value: float;
    max_value: float;

    func new(min_val: float, max_val: float, value: float) -> void {
        ui_require_range(min_val, max_val, "ProgressBar range")
        ui_require_value_in_range(value, min_val, max_val, "ProgressBar initial value")
        this.min_value = min_val
        this.max_value = max_val
        this.handle = widget_progress_bar(min_val, max_val, value)
        ui_require_state(this.handle != 0, "Failed to create ProgressBar")
    }

    func set_value(v: float) -> void {
        ui_require_handle(this.handle, "ProgressBar")
        ui_require_value_in_range(v, this.min_value, this.max_value, "ProgressBar value")
        widget_progress_set_value(this.handle, v)
    }

    func set_indeterminate(n: bool) -> void {
        ui_require_handle(this.handle, "ProgressBar")
        widget_progress_set_indeterminate(this.handle, ui_bool_to_i64(n))
    }

    func set_colors(fill: i64, bg: i64) -> void {
        ui_require_handle(this.handle, "ProgressBar")
        widget_progress_set_colors(this.handle, fill, bg)
    }

    func destroy() -> void {
        if this.handle != 0 {
            sg_node_destroy(this.handle)
            this.handle = 0
        }
    }
}

// ========================================================================
// TabPanel — self-contained tabs with auto content switching
// ========================================================================

class TabPanel {
    handle: i64;
    tab_count: i64;

    func new() -> void {
        this.handle = 0
        this.tab_count = 0
    }

    func new2(l1: string, c1: i64, l2: string, c2: i64) -> void {
        ui_require_non_empty(l1, "Tab 1 label")
        ui_require_non_empty(l2, "Tab 2 label")
        ui_require_handle(c1, "Tab 1 content")
        ui_require_handle(c2, "Tab 2 content")
        this.handle = widget_tabpanel(l1, c1, l2, c2, "", 0, "", 0)
        this.tab_count = 2
        ui_require_state(this.handle != 0, "Failed to create TabPanel")
    }

    func new3(l1: string, c1: i64, l2: string, c2: i64, l3: string, c3: i64) -> void {
        ui_require_non_empty(l1, "Tab 1 label")
        ui_require_non_empty(l2, "Tab 2 label")
        ui_require_non_empty(l3, "Tab 3 label")
        ui_require_handle(c1, "Tab 1 content")
        ui_require_handle(c2, "Tab 2 content")
        ui_require_handle(c3, "Tab 3 content")
        this.handle = widget_tabpanel(l1, c1, l2, c2, l3, c3, "", 0)
        this.tab_count = 3
        ui_require_state(this.handle != 0, "Failed to create TabPanel")
    }

    func new4(l1: string, c1: i64, l2: string, c2: i64, l3: string, c3: i64, l4: string, c4: i64) -> void {
        ui_require_non_empty(l1, "Tab 1 label")
        ui_require_non_empty(l2, "Tab 2 label")
        ui_require_non_empty(l3, "Tab 3 label")
        ui_require_non_empty(l4, "Tab 4 label")
        ui_require_handle(c1, "Tab 1 content")
        ui_require_handle(c2, "Tab 2 content")
        ui_require_handle(c3, "Tab 3 content")
        ui_require_handle(c4, "Tab 4 content")
        this.handle = widget_tabpanel(l1, c1, l2, c2, l3, c3, l4, c4)
        this.tab_count = 4
        ui_require_state(this.handle != 0, "Failed to create TabPanel")
    }

    func get_active() -> i64 {
        ui_require_handle(this.handle, "TabPanel")
        return widget_tabpanel_get_active(this.handle)
    }

    func set_active(index: i64) -> void {
        ui_require_handle(this.handle, "TabPanel")
        ui_require_non_negative_i64(index, "TabPanel active index")
        ui_require(index < this.tab_count, "TabPanel active index is out of range")
        widget_tabpanel_set_active(this.handle, index)
    }

    func set_min_size(w: float, h: float) -> void {
        ui_require_handle(this.handle, "TabPanel")
        ui_require_non_negative(w, "TabPanel minimum width")
        ui_require_non_negative(h, "TabPanel minimum height")
        sg_node_set_min_size(this.handle, w, h)
    }

    func destroy() -> void {
        if this.handle != 0 {
            sg_node_destroy(this.handle)
            this.handle = 0
        }
    }
}

// ========================================================================
// Color — ARGB color value helpers
// ========================================================================

class Color {
    value: i64;

    func from_rgb(r: i64, g: i64, b: i64) -> void {
        this.value = skia_color_rgb(r, g, b)
    }

    func from_rgba(r: i64, g: i64, b: i64, a: i64) -> void {
        this.value = skia_color_rgba(r, g, b, a)
    }

    func lighten(amount: i64) -> i64 {
        return sg_color_lighten(this.value, amount)
    }

    func darken(amount: i64) -> i64 {
        return sg_color_darken(this.value, amount)
    }

    func with_alpha(alpha: i64) -> i64 {
        return sg_color_with_alpha(this.value, alpha)
    }
}
