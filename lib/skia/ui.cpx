// Skia UI — High-level OOP wrappers for Casprix
// // Provides App, Column, Row, Button, Text, TextInput, etc. as
// classes wrapping the low-level extern functions from skia.cpx.

import "lib/skia/skia"

class Alignment {
    value: i64;
    label: string;

    func new(raw: i64, name: string) -> Alignment {
        this.value = raw
        this.label = name
        return this
    }
}

class ImageFit {
    value: i64;
    label: string;

    func new(raw: i64, name: string) -> ImageFit {
        this.value = raw
        this.label = name
        return this
    }
}

let ALIGN_START = new Alignment(0, "start")
let ALIGN_CENTER = new Alignment(1, "center")
let ALIGN_END = new Alignment(2, "end")
let ALIGN_STRETCH = new Alignment(3, "stretch")

let IMAGE_FIT_FILL = new ImageFit(0, "fill")
let IMAGE_FIT_CONTAIN = new ImageFit(1, "contain")
let IMAGE_FIT_COVER = new ImageFit(2, "cover")

func ui_bool_to_i64(value: bool) -> i64 {
    if value {
        return 1
    }
    return 0
}

// ui_require_* — precondition checks for the wrapper classes below.
//
// A failed precondition means the CALLER passed an argument the API forbids
// (a destroyed/zero handle, an empty required string, a negative size, ...).
// Previously these printed a message and let construction proceed with the
// bad value, which just deferred the crash to a later null dereference in
// unrelated code. They now abort immediately, at the exact bad call site,
// via ui_fatal (runtime/skia/widgets.c). This is a hard-stop, matching the
// rest of the runtime's contract-violation behaviour.

func ui_require(condition: bool, message: string) -> void {
    if !condition {
        ui_fatal(message)
    }
}

func ui_require_state(condition: bool, message: string) -> void {
    if !condition {
        ui_fatal(message)
    }
}

func ui_require_handle(handle: i64, context: string) -> void {
    if handle == 0 {
        ui_fatal(context)
    }
}

func ui_require_non_empty(value: string, context: string) -> void {
    if value == "" {
        ui_fatal(context)
    }
}

func ui_require_non_negative(value: float, context: string) -> void {
    if value < 0.0 {
        ui_fatal(context)
    }
}

func ui_require_positive_i64(value: i64, context: string) -> void {
    if value <= 0 {
        ui_fatal(context)
    }
}

func ui_require_non_negative_i64(value: i64, context: string) -> void {
    if value < 0 {
        ui_fatal(context)
    }
}

func ui_require_range(min_val: float, max_val: float, context: string) -> void {
    if max_val < min_val {
        ui_fatal(context)
    }
}

func ui_require_value_in_range(value: float, min_val: float, max_val: float, context: string) -> void {
    if value < min_val || value > max_val {
        ui_fatal(context)
    }
}

func create_font(family: string, size: float) -> i64 {
    ui_require_non_empty(family, "Font family")
    ui_require(size > 0.0, "Font size must be > 0")
    return skia_font_create(family, size)
}

func create_font_from_file(path: string, size: float) -> i64 {
    ui_require_non_empty(path, "Font file path")
    ui_require(size > 0.0, "Font size must be > 0")
    return skia_font_create_from_file(path, size)
}

let JAVAFX_BG_APP = 0xFFF3F6FA
let JAVAFX_BG_PANEL = 0xFFFFFFFF
let JAVAFX_BG_PANEL_ALT = 0xFFF8FBFE
let JAVAFX_BG_SIDEBAR = 0xFF1F2937
let JAVAFX_BG_SIDEBAR_ALT = 0xFF111827
let JAVAFX_BG_ACCENT = 0xFF3B82F6
let JAVAFX_BG_ACCENT_HOVER = 0xFF60A5FA
let JAVAFX_BG_ACCENT_PRESS = 0xFF2563EB
let JAVAFX_BG_GHOST = 0xFFF1F5F9
let JAVAFX_BG_SUCCESS = 0xFF10B981
let JAVAFX_BG_WARNING = 0xFFF59E0B
let JAVAFX_BORDER = 0xFFD6DEE8
let JAVAFX_BORDER_STRONG = 0xFFB8C5D6
let JAVAFX_TEXT = 0xFF1F2937
let JAVAFX_TEXT_MUTED = 0xFF6B7280
let JAVAFX_TEXT_SOFT = 0xFF94A3B8
let JAVAFX_TEXT_ON_DARK = 0xFFF8FAFC
let JAVAFX_SHADOW = 0x14111827
let JAVAFX_SHADOW_SOFT = 0x0F111827

func javafx_style_root(handle: i64) -> void {
    ui_require_handle(handle, "JavaFX root")
    sg_style_app_root(handle)
}

func javafx_style_panel(handle: i64) -> void {
    ui_require_handle(handle, "JavaFX panel")
    sg_style_panel(handle)
}

func javafx_style_toolbar(handle: i64) -> void {
    ui_require_handle(handle, "JavaFX toolbar")
    sg_style_toolbar(handle)
}

func javafx_style_sidebar(handle: i64) -> void {
    ui_require_handle(handle, "JavaFX sidebar")
    sg_style_sidebar(handle)
}

func javafx_style_card(handle: i64) -> void {
    ui_require_handle(handle, "JavaFX card")
    sg_style_card(handle)
}

func javafx_style_card_alt(handle: i64) -> void {
    ui_require_handle(handle, "JavaFX alternate card")
    sg_style_panel_alt(handle)
}

func javafx_style_primary_button(handle: i64) -> void {
    ui_require_handle(handle, "JavaFX primary button")
    widget_button_set_colors(handle, JAVAFX_BG_ACCENT, JAVAFX_BG_ACCENT_HOVER, JAVAFX_BG_ACCENT_PRESS, 0xFFFFFFFF)
    sg_style_set_border(handle, sg_color_with_alpha(0xFF1D4ED8, 100), 1.0, 14.0)
    sg_style_set_shadow(handle, 0.0, 10.0, 22.0, 0x1D3B82F6)
    sg_node_set_min_size(handle, 128.0, 44.0)
}

func javafx_style_secondary_button(handle: i64) -> void {
    ui_require_handle(handle, "JavaFX secondary button")
    widget_button_set_colors(handle, JAVAFX_BG_GHOST, 0xFFE2E8F0, 0xFFD6DEE8, JAVAFX_TEXT)
    sg_style_set_border(handle, JAVAFX_BORDER, 1.0, 14.0)
    sg_style_set_shadow(handle, 0.0, 6.0, 18.0, 0x08111827)
    sg_node_set_min_size(handle, 112.0, 44.0)
}

func javafx_style_sidebar_button(handle: i64) -> void {
    ui_require_handle(handle, "JavaFX sidebar button")
    widget_button_set_colors(handle, 0xFF273244, 0xFF334155, 0xFF1E293B, JAVAFX_TEXT_ON_DARK)
    sg_style_set_border(handle, 0xFF3B475A, 1.0, 14.0)
    sg_style_set_shadow(handle, 0.0, 8.0, 18.0, 0x12000000)
    sg_node_set_min_size(handle, 180.0, 42.0)
}

func javafx_style_input(handle: i64) -> void {
    ui_require_handle(handle, "JavaFX input")
    sg_style_set_background(handle, JAVAFX_BG_PANEL)
    sg_style_set_border(handle, JAVAFX_BORDER_STRONG, 1.0, 14.0)
    sg_style_set_shadow(handle, 0.0, 6.0, 18.0, 0x08111827)
    sg_node_set_min_size(handle, 220.0, 46.0)
}

func javafx_style_progress(handle: i64) -> void {
    ui_require_handle(handle, "JavaFX progress")
    widget_progress_set_colors(handle, JAVAFX_BG_ACCENT, 0xFFE5ECF5)
}

func javafx_style_separator(handle: i64) -> void {
    ui_require_handle(handle, "JavaFX separator")
    sg_style_set_background(handle, JAVAFX_BORDER)
}

func javafx_add_text(parent: i64, content: string, font: i64, color: i64) -> i64 {
    ui_require_handle(parent, "JavaFX text parent")
    ui_require_handle(font, "JavaFX text font")
    let label = new Text(content, font, color)
    sg_node_add_child(parent, label.handle)
    return label.handle
}

// ========================================================================
// Application
// ========================================================================

class App {
    handle: i64;
    root_handle: i64;
    font_handle: i64;

    func new(title: string, width: i64, height: i64) -> void {
        ui_require_non_empty(title, "App title")
        ui_require_positive_i64(width, "App width")
        ui_require_positive_i64(height, "App height")

        this.handle = sg_app_create(title, width, height)
        ui_require_state(this.handle != 0, "Failed to initialize the Skia renderer")

        this.font_handle = skia_font_create("Segoe UI", 14.0)
        if this.font_handle == 0 {
            sg_app_destroy(this.handle)
            this.handle = 0
            print("Skia renderer started, but the default UI font could not be created")
        }
    }

    func set_root(node: i64) -> void {
        ui_require_handle(this.handle, "App")
        ui_require_handle(node, "App root node")
        this.root_handle = node
        sg_app_set_root(this.handle, node)
    }

    func run() -> void {
        ui_require_handle(this.handle, "App")
        sg_app_run(this.handle)
    }

    func quit() -> void {
        ui_require_handle(this.handle, "App")
        sg_app_quit(this.handle)
    }

    func get_font() -> i64 {
        ui_require_handle(this.font_handle, "App font")
        return this.font_handle
    }

    func set_fps(fps: i64) -> void {
        ui_require_handle(this.handle, "App")
        ui_require_positive_i64(fps, "Target FPS")
        sg_app_set_fps(this.handle, fps)
    }

    func get_anim_pool() -> i64 {
        ui_require_handle(this.handle, "App")
        let pool = sg_app_get_animations(this.handle)
        ui_require_handle(pool, "Animation pool")
        return pool
    }

    func fade_in(node: i64, duration: float) -> i64 {
        ui_require_handle(this.handle, "App")
        ui_require_handle(node, "Animated node")
        ui_require(duration > 0.0, "Fade-in duration must be > 0")
        return sg_fade_in(this.get_anim_pool(), node, duration)
    }

    func fade_out(node: i64, duration: float) -> i64 {
        ui_require_handle(this.handle, "App")
        ui_require_handle(node, "Animated node")
        ui_require(duration > 0.0, "Fade-out duration must be > 0")
        return sg_fade_out(this.get_anim_pool(), node, duration)
    }

    func invalidate() -> void {
        ui_require_handle(this.handle, "App")
        sg_app_invalidate(this.handle)
    }

    func destroy() -> void {
        if this.font_handle != 0 {
            skia_font_destroy(this.font_handle)
            this.font_handle = 0
        }
        if this.handle != 0 {
            sg_app_destroy(this.handle)
            this.handle = 0
        }
        this.root_handle = 0
    }
}

// ========================================================================
// Layout Containers
// ========================================================================

class Column {
    handle: i64;

    func new(spacing: float) -> void {
        ui_require_non_negative(spacing, "Column spacing")
        this.handle = widget_column(spacing)
        ui_require_state(this.handle != 0, "Failed to create Column")
    }

    func add(child: i64) -> void {
        ui_require_handle(this.handle, "Column")
        ui_require_handle(child, "Column child")
        sg_node_add_child(this.handle, child)
    }

    func set_padding(p: float) -> void {
        ui_require_handle(this.handle, "Column")
        ui_require_non_negative(p, "Column padding")
        sg_style_set_padding_uniform(this.handle, p)
    }

    func set_background(color: i64) -> void {
        ui_require_handle(this.handle, "Column")
        sg_style_set_background(this.handle, color)
    }

    func set_border(color: i64, width: float, radius: float) -> void {
        ui_require_handle(this.handle, "Column")
        ui_require_non_negative(width, "Column border width")
        ui_require_non_negative(radius, "Column border radius")
        sg_style_set_border(this.handle, color, width, radius)
    }

    func set_min_size(w: float, h: float) -> void {
        ui_require_handle(this.handle, "Column")
        ui_require_non_negative(w, "Column minimum width")
        ui_require_non_negative(h, "Column minimum height")
        sg_node_set_min_size(this.handle, w, h)
    }

    func set_max_size(w: float, h: float) -> void {
        ui_require_handle(this.handle, "Column")
        ui_require_non_negative(w, "Column maximum width")
        ui_require_non_negative(h, "Column maximum height")
        sg_node_set_max_size(this.handle, w, h)
    }

    func set_flex_grow(grow: float) -> void {
        ui_require_handle(this.handle, "Column")
        ui_require_non_negative(grow, "Column flex grow")
        sg_node_set_flex_grow(this.handle, grow)
    }

    func set_align_self(align: Alignment) -> void {
        ui_require_handle(this.handle, "Column")
        sg_node_set_align_self(this.handle, align.value)
    }

    func set_align_items(align: Alignment) -> void {
        ui_require_handle(this.handle, "Column")
        sg_node_set_align_items(this.handle, align.value)
    }

    func set_visible(v: bool) -> void {
        ui_require_handle(this.handle, "Column")
        sg_node_set_visible(this.handle, ui_bool_to_i64(v))
    }

    func destroy() -> void {
        if this.handle != 0 {
            sg_node_destroy(this.handle)
            this.handle = 0
        }
    }
}

