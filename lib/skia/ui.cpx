// ========================================================================
// Widget Wrappers
// ========================================================================

class Text {
    handle: i64;

    func new(content: string, font: i64, color: i64) -> void {
        ui_require_handle(font, "Text font")
        this.handle = widget_text(content, font, color)
        ui_require_state(this.handle != 0, "Failed to create Text node")
    }

    func set_text(content: string) -> void {
        ui_require_handle(this.handle, "Text")
        widget_text_set(this.handle, content)
    }

    // Enable word wrapping. The label wraps to the width it is laid out at;
    // an explicit "\n" in the content always starts a new line regardless.
    func set_wrap(wrap: bool) -> void {
        ui_require_handle(this.handle, "Text")
        widget_text_set_wrap(this.handle, ui_bool_to_i64(wrap))
    }

    // Cap the number of rendered lines. 0 = unlimited. No ellipsis (v1).
    func set_max_lines(max_lines: i64) -> void {
        ui_require_handle(this.handle, "Text")
        ui_require_non_negative_i64(max_lines, "Text max_lines")
        widget_text_set_max_lines(this.handle, max_lines)
    }

    // Accessibility (v1b): override the auto-derived label (useful when the
    // rendered text isn't a good spoken label).
    func set_a11y_label(label: string) -> void {
        ui_require_handle(this.handle, "Text")
        widget_set_a11y_label(this.handle, label)
    }

    // Hide this node from the accessibility tree (decorative text).
    func set_a11y_hidden(hidden: bool) -> void {
        ui_require_handle(this.handle, "Text")
        widget_set_a11y_hidden(this.handle, ui_bool_to_i64(hidden))
    }

    func destroy() -> void {
        if this.handle != 0 {
            sg_node_destroy(this.handle)
            this.handle = 0
        }
    }
}

class Button {
    handle: i64;

    func new(label: string, font: i64) -> void {
        ui_require_handle(font, "Button font")
        this.handle = widget_button(label, font, 0, 0)
        ui_require_state(this.handle != 0, "Failed to create Button")
    }

    func set_background(color: i64) -> void {
        ui_require_handle(this.handle, "Button")
        sg_style_set_background(this.handle, color)
    }

    func set_border(color: i64, width: float, radius: float) -> void {
        ui_require_handle(this.handle, "Button")
        ui_require_non_negative(width, "Button border width")
        ui_require_non_negative(radius, "Button border radius")
        sg_style_set_border(this.handle, color, width, radius)
    }

    func set_padding(p: float) -> void {
        ui_require_handle(this.handle, "Button")
        ui_require_non_negative(p, "Button padding")
        sg_style_set_padding_uniform(this.handle, p)
    }

    func set_colors(normal: i64, hover: i64, press: i64, text: i64) -> void {
        ui_require_handle(this.handle, "Button")
        widget_button_set_colors(this.handle, normal, hover, press, text)
    }

    func set_shadow(ox: float, oy: float, blur: float, color: i64) -> void {
        ui_require_handle(this.handle, "Button")
        ui_require_non_negative(blur, "Button shadow blur")
        sg_style_set_shadow(this.handle, ox, oy, blur, color)
    }

    func set_enabled(e: bool) -> void {
        ui_require_handle(this.handle, "Button")
        widget_button_set_enabled(this.handle, ui_bool_to_i64(e))
    }

    func set_on_click(callback: i64, ctx: i64) -> void {
        ui_require_handle(this.handle, "Button")
        ui_require(callback != 0 || ctx == 0, "Button callback context requires a non-zero callback")
        widget_button_set_callback(this.handle, callback, ctx)
    }

    func set_min_size(w: float, h: float) -> void {
        ui_require_handle(this.handle, "Button")
        ui_require_non_negative(w, "Button minimum width")
        ui_require_non_negative(h, "Button minimum height")
        sg_node_set_min_size(this.handle, w, h)
    }

    // Accessibility (v1b): set an explicit spoken label — essential for
    // icon-only buttons whose visible text is a glyph.
    func set_a11y_label(label: string) -> void {
        ui_require_handle(this.handle, "Button")
        widget_set_a11y_label(this.handle, label)
    }

    func destroy() -> void {
        if this.handle != 0 {
            sg_node_destroy(this.handle)
            this.handle = 0
        }
    }
}

class TextInput {
    handle: i64;

    func new(placeholder: string, font: i64) -> void {
        ui_require_handle(font, "TextInput font")
        this.handle = widget_text_input(placeholder, font)
        ui_require_state(this.handle != 0, "Failed to create TextInput")
    }

    func get_value() -> string {
        ui_require_handle(this.handle, "TextInput")
        return widget_text_input_get_value(this.handle)
    }

    func set_value(text: string) -> void {
        ui_require_handle(this.handle, "TextInput")
        widget_text_input_set_value(this.handle, text)
    }

    func set_on_change(callback: i64, ctx: i64) -> void {
        ui_require_handle(this.handle, "TextInput")
        ui_require(callback != 0 || ctx == 0, "TextInput callback context requires a non-zero callback")
        widget_text_input_on_change(this.handle, callback, ctx)
    }

    func set_min_size(w: float, h: float) -> void {
        ui_require_handle(this.handle, "TextInput")
        ui_require_non_negative(w, "TextInput minimum width")
        ui_require_non_negative(h, "TextInput minimum height")
        sg_node_set_min_size(this.handle, w, h)
    }

    func set_flex_grow(grow: float) -> void {
        ui_require_handle(this.handle, "TextInput")
        ui_require_non_negative(grow, "TextInput flex grow")
        sg_node_set_flex_grow(this.handle, grow)
    }

    func set_align_self(align: Alignment) -> void {
        ui_require_handle(this.handle, "TextInput")
        sg_node_set_align_self(this.handle, align.value)
    }

    func set_background(color: i64) -> void {
        ui_require_handle(this.handle, "TextInput")
        sg_style_set_background(this.handle, color)
    }

    func set_border(color: i64, width: float, radius: float) -> void {
        ui_require_handle(this.handle, "TextInput")
        ui_require_non_negative(width, "TextInput border width")
        ui_require_non_negative(radius, "TextInput border radius")
        sg_style_set_border(this.handle, color, width, radius)
    }

    func set_shadow(ox: float, oy: float, blur: float, color: i64) -> void {
        ui_require_handle(this.handle, "TextInput")
        ui_require_non_negative(blur, "TextInput shadow blur")
        sg_style_set_shadow(this.handle, ox, oy, blur, color)
    }

    // Accessibility (v1b): a spoken label for the field (its own text is the
    // editable value, not a label).
    func set_a11y_label(label: string) -> void {
        ui_require_handle(this.handle, "TextInput")
        widget_set_a11y_label(this.handle, label)
    }

    // Enable/disable. A disabled input is styled distinctly, stops receiving
    // events, rejects focus/cursor/typing, and reports SG_STATE_DISABLED
    // through the accessibility bridge (not-enabled / not-focusable).
    func set_enabled(e: bool) -> void {
        ui_require_handle(this.handle, "TextInput")
        widget_text_input_set_enabled(this.handle, ui_bool_to_i64(e))
    }

    func is_enabled() -> bool {
        ui_require_handle(this.handle, "TextInput")
        return widget_text_input_is_enabled(this.handle) != 0
    }

    // Mark/clear an error state — distinct border+background from
    // normal/disabled/focused. Does NOT block input: an errored field stays
    // editable so the user can fix it.
    func set_error(has_error: bool) -> void {
        ui_require_handle(this.handle, "TextInput")
        widget_text_input_set_error(this.handle, ui_bool_to_i64(has_error))
    }

    func has_error() -> bool {
        ui_require_handle(this.handle, "TextInput")
        return widget_text_input_has_error(this.handle) != 0
    }

    func destroy() -> void {
        if this.handle != 0 {
            sg_node_destroy(this.handle)
            this.handle = 0
        }
    }
}

class Checkbox {
    handle: i64;

    func new(label: string, font: i64, initial: bool) -> void {
        ui_require_handle(font, "Checkbox font")
        this.handle = widget_checkbox(label, font, ui_bool_to_i64(initial))
        ui_require_state(this.handle != 0, "Failed to create Checkbox")
    }

    func is_checked() -> bool {
        ui_require_handle(this.handle, "Checkbox")
        return widget_checkbox_is_checked(this.handle) != 0
    }

    func set_checked(val: bool) -> void {
        ui_require_handle(this.handle, "Checkbox")
        widget_checkbox_set_checked(this.handle, ui_bool_to_i64(val))
    }

    func set_on_change(callback: i64, ctx: i64) -> void {
        ui_require_handle(this.handle, "Checkbox")
        ui_require(callback != 0 || ctx == 0, "Checkbox callback context requires a non-zero callback")
        widget_checkbox_on_change(this.handle, callback, ctx)
    }

    func destroy() -> void {
        if this.handle != 0 {
            sg_node_destroy(this.handle)
            this.handle = 0
        }
    }
}

class Slider {
    handle: i64;
    min_value: float;
    max_value: float;

    func new(min_val: float, max_val: float, initial: float) -> void {
        ui_require_range(min_val, max_val, "Slider range")
        ui_require_value_in_range(initial, min_val, max_val, "Slider initial value")
        this.min_value = min_val
        this.max_value = max_val
        this.handle = widget_slider(min_val, max_val, initial)
        ui_require_state(this.handle != 0, "Failed to create Slider")
    }

    func get_value() -> float {
        ui_require_handle(this.handle, "Slider")
        return widget_slider_get_value(this.handle)
    }

    func set_value(val: float) -> void {
        ui_require_handle(this.handle, "Slider")
        ui_require_value_in_range(val, this.min_value, this.max_value, "Slider value")
        widget_slider_set_value(this.handle, val)
    }

    func set_on_change(callback: i64, ctx: i64) -> void {
        ui_require_handle(this.handle, "Slider")
        ui_require(callback != 0 || ctx == 0, "Slider callback context requires a non-zero callback")
        widget_slider_on_change(this.handle, callback, ctx)
    }

    func destroy() -> void {
        if this.handle != 0 {
            sg_node_destroy(this.handle)
            this.handle = 0
        }
    }
}

class ImageView {
    handle: i64;

    func new(path: string, fit: ImageFit) -> void {
        ui_require_non_empty(path, "Image path")
        this.handle = widget_image(path, fit.value)
        ui_require_state(this.handle != 0, "Failed to create ImageView")
    }

    func destroy() -> void {
        if this.handle != 0 {
            sg_node_destroy(this.handle)
            this.handle = 0
        }
    }
}

class Separator {
