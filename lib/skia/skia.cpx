// Progress Bar
// ========================================================================

extern func widget_progress_bar(min_val: float, max_val: float, value: float) -> i64
extern func widget_progress_set_value(bar: i64, value: float) -> void
extern func widget_progress_set_indeterminate(bar: i64, indeterminate: i64) -> void
extern func widget_progress_set_colors(bar: i64, fill: i64, bg: i64) -> void

// ========================================================================
// Tab Panel (compound widget — auto content switching on click)
// ========================================================================

extern func widget_tabpanel(l1: string, c1: i64, l2: string, c2: i64, l3: string, c3: i64, l4: string, c4: i64) -> i64
extern func widget_tabpanel_get_active(root: i64) -> i64
extern func widget_tabpanel_set_active(root: i64, index: i64) -> void

// ========================================================================
// Node Helpers
// ========================================================================

extern func sg_node_set_visible(node: i64, visible: i64) -> void
extern func sg_node_set_min_size(node: i64, min_w: float, min_h: float) -> void
extern func sg_node_set_max_size(node: i64, max_w: float, max_h: float) -> void
extern func sg_node_set_flex_grow(node: i64, grow: float) -> void
extern func sg_node_set_align_self(node: i64, align: i64) -> void
extern func sg_node_set_align_items(node: i64, align: i64) -> void

// ========================================================================
// Button extras
// ========================================================================

extern func widget_button_set_enabled(btn: i64, enabled: i64) -> void
extern func widget_button_set_colors(btn: i64, normal: i64, hover: i64, press: i64, text_color: i64) -> void
extern func widget_button_set_callback(btn: i64, on_click: i64, ctx: i64) -> void

// ========================================================================
// Widget callbacks
// ========================================================================

extern func widget_text_input_on_change(node: i64, callback: i64, user_data: i64) -> void
extern func widget_checkbox_on_change(node: i64, callback: i64, user_data: i64) -> void
extern func widget_slider_on_change(node: i64, callback: i64, user_data: i64) -> void

// ========================================================================
// App extras
// ========================================================================

extern func sg_app_get_animations(app: i64) -> i64

// ========================================================================
// Animation
// Property codes: 0=x 1=y 2=w 3=h 4=opacity 5=scale_x 6=scale_y 7=rotation
// Easing codes:   0=linear 1=in_quad 2=out_quad 3=in_out_quad 4=in_cubic ...
// ========================================================================

extern func sg_animate(pool: i64, target: i64, property: i64, from_val: float, to_val: float, duration: float, easing: i64) -> i64
extern func sg_animate_cancel(pool: i64, anim: i64) -> void
