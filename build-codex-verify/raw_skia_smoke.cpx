import "lib/skia/skia"

func main() -> int {
    let app: i64 = sg_app_create("Raw Skia Smoke", 320, 240)
    if app == 0 {
        return 1
    }

    let root: i64 = widget_column(12.0)
    let font: i64 = skia_font_create("Segoe UI", 18.0)
    let title: i64 = widget_text("Hello from Casprix Skia", font, 0xFF202020)

    sg_style_set_padding_uniform(root, 16.0)
    sg_style_set_background(root, 0xFFF5F5F5)
    sg_node_add_child(root, title)
    sg_app_set_root(app, root)

    sg_app_destroy(app)
    sg_node_destroy(root)
    skia_font_destroy(font)
    return 0
}
